@model List<GreenCityReporter.Models.Donation>
@{ ViewData["Title"] = "Manage Donations"; }
<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between gap-2 mb-4"><div><h1 class="h3 fw-bold">Donation management</h1><p class="text-muted mb-0">View donor names, amounts, payment details, and verification status. Showing the latest 200 donations.</p></div></div>
    @if (TempData["DonationNotice"] is string notice) { <div class="alert alert-info" role="status">@notice</div> }
    @if (Model.Count == 0) { <div class="card p-5 text-center text-muted">No donations have been submitted yet.</div> }
    else {
        <div class="card table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Reference / date (UTC)</th><th>Donor</th><th>Payment</th><th>Status</th></tr></thead><tbody>
        @foreach (var donation in Model) {
            <tr><td class="text-break">@donation.TransactionId<small class="d-block text-muted">@donation.CreatedAt.ToString("dd MMM yyyy HH:mm")</small>@if (donation.IsSandbox) { <span class="badge bg-info text-dark">@(donation.Provider == "Demo" ? "Demo - no money" : "Sandbox")</span> }</td><td>@(string.IsNullOrEmpty(donation.DonorName) ? donation.User?.FullName : donation.DonorName)<small class="d-block text-muted">@(donation.Email ?? donation.User?.Email)</small><small class="d-block">@(donation.Phone ?? donation.SenderPhone)</small>@if (!string.IsNullOrEmpty(donation.Message)) { <p class="small mb-0 mt-1">@donation.Message</p> }</td><td><strong>BDT @donation.Amount.ToString("N2")</strong><small class="d-block">@donation.PaymentMethod · @donation.Provider</small><small class="d-block text-break">@donation.BankTransactionId</small>@if (donation.ReceiptToken != null) { <a asp-action="Receipt" asp-route-token="@donation.ReceiptToken" class="small">Payment details</a> }</td><td>
            <span class="badge @(donation.Status == DonationStatus.Confirmed ? "bg-success" : donation.Status is DonationStatus.Pending or DonationStatus.UnderReview ? "bg-warning text-dark" : "bg-secondary") mb-2">@donation.Status</span>
            @if ((donation.Provider == "Manual" && donation.Status == DonationStatus.Pending) || donation.Status == DonationStatus.UnderReview) {
                <p class="small text-muted">@(donation.Status == DonationStatus.UnderReview ? "Complete the customer risk review before releasing this verified payment." : "Verify the transaction and exact amount in the receiving wallet.")</p>
                <form asp-action="Review" method="post"><input type="hidden" name="id" value="@donation.Id" /><label class="small d-block mb-2"><input type="checkbox" name="verified" value="true" /> I completed the required verification.</label><div class="d-flex gap-2"><button name="status" value="Confirmed" class="btn btn-sm btn-success">Confirm</button><button name="status" value="Rejected" class="btn btn-sm btn-outline-danger">Reject</button></div></form>
            }
            @if (donation.ReviewedAt != null) { <small class="d-block text-muted">Reviewed @donation.ReviewedAt?.ToString("dd MMM yyyy HH:mm")</small> }
            </td></tr>
        }
        </tbody></table></div>
    }
</div>
