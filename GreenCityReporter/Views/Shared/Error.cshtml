@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card p-4 p-md-5">
                <div class="empty-state-icon empty-state-icon-danger mb-3"><i class="fa-solid fa-triangle-exclamation"></i></div>
                <h1 class="h3 fw-bold mb-2">Something went wrong</h1>
                <p class="text-muted">An error occurred while processing your request.</p>
                @if (Model.ShowRequestId)
                {
                    <p class="small text-muted mb-4"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
                }
                <details class="small text-muted">
                    <summary class="fw-semibold">Developer troubleshooting</summary>
                    <p class="mt-3 mb-0">Swapping to <strong>Development</strong> environment will display more detailed information. Do not enable Development mode for deployed applications.</p>
                </details>
            </div>
        </div>
    </div>
</div>
