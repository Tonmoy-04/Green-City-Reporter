
@using Microsoft.AspNetCore.Identity
@using GreenCityReporter.Models
@inject UserManager<ApplicationUser> UserManager
@inject GreenCityReporter.Data.ApplicationDbContext DbContext

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Green City Reporter</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- FontAwesome and Google Fonts -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GreenCityReporter.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-4 py-3">
            <div class="container">

                <!-- Brand -->
                <a class="navbar-brand fw-bold text-success d-flex align-items-center"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    <i class="fa-solid fa-leaf me-2"></i> Green City
                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler border-0"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- Main Navigation -->
                    <ul class="navbar-nav mx-auto">

                        <li class="nav-item">
                            <a class="nav-link text-dark fw-medium mx-2"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                <i class="fa-solid fa-house me-1 text-success"></i> Home
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-medium mx-2"
                                   asp-area=""
                                   asp-controller="Report"
                                   asp-action="Create">
                                    <i class="fa-solid fa-plus-circle me-1 text-success"></i> Report an Issue
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark fw-medium mx-2"
                                   asp-area=""
                                   asp-controller="Report"
                                   asp-action="MyReports">
                                    <i class="fa-solid fa-list-check me-1 text-success"></i> My Reports
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link text-dark fw-medium mx-2"
                               asp-area=""
                               asp-controller="Report"
                               asp-action="Track">
                                <i class="fa-solid fa-magnifying-glass me-1 text-success"></i> Track Report
                            </a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-medium mx-2"
                                   asp-area=""
                                   asp-controller="Admin"
                                   asp-action="Index">
                                    <i class="fa-solid fa-user-shield me-1 text-primary"></i> Dashboard
                                </a>
                            </li>
                        }

                    </ul>

                    <!-- User Navigation -->
                    <ul class="navbar-nav align-items-center">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var currentUser = await UserManager.GetUserAsync(User);
                            int unreadCount = 0;
                            if (currentUser != null)
                            {
                                unreadCount = DbContext.Notifications.Count(n => n.UserId == currentUser.Id && !n.IsRead);
                            }

                            <li class="nav-item me-2">
                                <a class="nav-link text-dark fw-medium position-relative"
                                   asp-area=""
                                   asp-controller="Notification"
                                   asp-action="Index"
                                   title="Notifications">
                                    <i class="fa-solid fa-bell fa-lg text-secondary"></i>
                                    @if (unreadCount > 0)
                                    {
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                            @unreadCount
                                            <span class="visually-hidden">unread notifications</span>
                                        </span>
                                    }
                                </a>
                            </li>

                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle text-dark fw-medium"
                                   href="#"
                                   id="navbarDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    <i class="fa-solid fa-user-circle me-1 text-success"></i>

                                    @(currentUser?.FullName ?? "User")

                                </a>

                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0"
                                    aria-labelledby="navbarDropdown">

                                    <li>
                                        <a class="dropdown-item" asp-controller="Report" asp-action="MyReports">
                                            <i class="fa-solid fa-folder-open me-2 text-muted"></i> My Reports
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Notification" asp-action="Index">
                                            <i class="fa-solid fa-bell me-2 text-muted"></i> Notifications
                                            @if (unreadCount > 0)
                                            {
                                                <span class="badge bg-danger ms-1">@unreadCount</span>
                                            }
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>

                                    <li>
                                        <form class="form-inline"
                                              asp-area=""
                                              asp-controller="Account"
                                              asp-action="Logout"
                                              method="post">

                                            <button type="submit"
                                                    class="dropdown-item text-danger">
                                                <i class="fa-solid fa-right-from-bracket me-2"></i>
                                                Logout
                                            </button>

                                        </form>
                                    </li>

                                </ul>

                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-medium"
                                   asp-area=""
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Login
                                </a>
                            </li>

                            <li class="nav-item ms-2">
                                <a class="btn btn-success px-4 rounded-pill"
                                   asp-area=""
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Register
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Green City Reporter
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

