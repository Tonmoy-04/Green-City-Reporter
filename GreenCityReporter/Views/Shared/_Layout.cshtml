@using Microsoft.AspNetCore.Identity
@using GreenCityReporter.Models
@inject UserManager<ApplicationUser> UserManager
@inject GreenCityReporter.Data.ApplicationDbContext DbContext

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Green City Reporter</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- FontAwesome and Google Fonts -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GreenCityReporter.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="d-flex flex-column min-vh-100 gcr-body">
    <!-- Top Scroll Progress Indicator -->
    <div id="scroll-progress" class="scroll-progress-bar"></div>

    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg gcr-navbar border-bottom py-2 shadow-sm">
            <div class="container">

                <!-- Brand Logo -->
                @if (User.IsInRole("Admin"))
                {
                    <a class="navbar-brand fw-bold text-success d-flex align-items-center me-4" asp-area="" asp-controller="Admin" asp-action="Index">
                        <span class="brand-icon-wrapper me-2">
                            <i class="fa-solid fa-leaf text-success"></i>
                        </span>
                        <span class="brand-text text-dark">Green City<span class="brand-subtext text-muted ms-1 fw-normal">Reporter</span></span>
                    </a>
                }
                else if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="navbar-brand fw-bold text-success d-flex align-items-center me-4" asp-area="" asp-controller="Report" asp-action="Dashboard">
                        <span class="brand-icon-wrapper me-2">
                            <i class="fa-solid fa-leaf text-success"></i>
                        </span>
                        <span class="brand-text text-dark">Green City<span class="brand-subtext text-muted ms-1 fw-normal">Reporter</span></span>
                    </a>
                }
                else
                {
                    <a class="navbar-brand fw-bold text-success d-flex align-items-center me-4" asp-area="" asp-controller="Home" asp-action="Index">
                        <span class="brand-icon-wrapper me-2">
                            <i class="fa-solid fa-leaf text-success"></i>
                        </span>
                        <span class="brand-text text-dark">Green City<span class="brand-subtext text-muted ms-1 fw-normal">Reporter</span></span>
                    </a>
                }

                <!-- Mobile Toggle Button -->
                <button class="navbar-toggler border-0 shadow-none"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbarCollapse"
                        aria-controls="mainNavbarCollapse"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbarCollapse">

                    <!-- Main Navigation Links -->
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 align-items-lg-center">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            if (!User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link fw-medium mx-1" asp-area="" asp-controller="Report" asp-action="Dashboard">
                                        <i class="fa-solid fa-chart-pie me-1 text-success"></i> Dashboard
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link fw-medium mx-1" asp-area="" asp-controller="Report" asp-action="Create">
                                        <i class="fa-solid fa-circle-plus me-1 text-success"></i> Report Issue
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link fw-medium mx-1" asp-area="" asp-controller="Report" asp-action="MyReports">
                                        <i class="fa-solid fa-folder-open me-1 text-success"></i> My Reports
                                    </a>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link fw-medium mx-1" asp-area="" asp-controller="Report" asp-action="Track">
                                    <i class="fa-solid fa-magnifying-glass me-1 text-success"></i> Track Report
                                </a>
                            </li>

                            if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link fw-medium mx-1 text-primary fw-bold" asp-area="" asp-controller="Admin" asp-action="Index">
                                        <i class="fa-solid fa-user-shield me-1"></i> Admin Dashboard
                                    </a>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-medium mx-1" asp-area="" asp-controller="Home" asp-action="Index">
                                    <i class="fa-solid fa-house me-1 text-success"></i> Home
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link fw-medium mx-1" asp-area="" asp-controller="Report" asp-action="Track">
                                    <i class="fa-solid fa-magnifying-glass me-1 text-success"></i> Track Report
                                </a>
                            </li>
                        }

                    </ul>

                    <!-- Right User Actions / Auth Buttons -->
                    <ul class="navbar-nav align-items-lg-center">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var currentUser = await UserManager.GetUserAsync(User);
                            int unreadCount = 0;
                            if (currentUser != null)
                            {
                                unreadCount = DbContext.Notifications.Count(n => n.UserId == currentUser.Id && !n.IsRead);
                            }

                            <!-- Notification Icon Badge -->
                            <li class="nav-item me-lg-2 mb-2 mb-lg-0">
                                <a class="nav-link text-dark position-relative p-2 d-inline-flex align-items-center"
                                   asp-area=""
                                   asp-controller="Notification"
                                   asp-action="Index"
                                   title="Notifications">
                                    <span class="notification-bell-wrapper d-inline-flex align-items-center justify-content-center rounded-circle bg-light border transition-all" style="width: 38px; height: 38px;">
                                        <i class="fa-solid fa-bell @(unreadCount > 0 ? "text-warning" : "text-secondary")"></i>
                                    </span>
                                    @if (unreadCount > 0)
                                    {
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-light shadow-sm" style="font-size: 0.65rem;">
                                            @unreadCount
                                            <span class="visually-hidden">unread notifications</span>
                                        </span>
                                    }
                                </a>
                            </li>

                            <!-- Profile Dropdown -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark fw-semibold d-flex align-items-center"
                                   href="#"
                                   id="navbarDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    <span class="user-avatar-initial me-2 text-white rounded-circle d-inline-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 34px; height: 34px; font-size: 0.85rem; background-color: var(--gcr-primary);">
                                        @((currentUser?.FullName ?? "U").Substring(0, 1).ToUpper())
                                    </span>
                                    <span>@(currentUser?.FullName ?? "User")</span>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2 p-2" aria-labelledby="navbarDropdown">
                                    <li class="px-3 py-2 border-bottom mb-2 bg-light rounded-2">
                                        <small class="text-muted d-block">Signed in as</small>
                                        <strong class="text-dark small text-truncate d-block">@(currentUser?.Email ?? "")</strong>
                                    </li>
                                    @if (!User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 rounded-2" asp-controller="Report" asp-action="Dashboard">
                                                <i class="fa-solid fa-chart-line me-2 text-success"></i> Citizen Dashboard
                                            </a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 rounded-2" asp-controller="Admin" asp-action="Index">
                                                <i class="fa-solid fa-user-shield me-2 text-primary"></i> Admin Dashboard
                                            </a>
                                        </li>
                                    }
                                    <li>
                                        <a class="dropdown-item py-2 rounded-2" asp-controller="Account" asp-action="Profile">
                                            <i class="fa-solid fa-user-gear me-2 text-success"></i> Profile & Settings
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-2"></li>
                                    @if (!User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 rounded-2" asp-controller="Report" asp-action="MyReports">
                                                <i class="fa-solid fa-folder-open me-2 text-muted"></i> My Reports
                                            </a>
                                        </li>
                                    }
                                    <li>
                                        <a class="dropdown-item py-2 rounded-2 d-flex justify-content-between align-items-center" asp-controller="Notification" asp-action="Index">
                                            <span><i class="fa-solid fa-bell me-2 text-muted"></i> Notifications</span>
                                            @if (unreadCount > 0)
                                            {
                                                <span class="badge bg-danger rounded-pill ms-2">@unreadCount</span>
                                            }
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-2"></li>
                                    <li>
                                        <form class="form-inline"
                                              asp-area=""
                                              asp-controller="Account"
                                              asp-action="Logout"
                                              method="post">
                                            <button type="submit"
                                                    class="dropdown-item text-danger py-2 rounded-2">
                                                <i class="fa-solid fa-right-from-bracket me-2"></i>
                                                Sign Out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-secondary px-3 btn-sm fw-semibold" asp-area="" asp-controller="Account" asp-action="Login">
                                    <i class="fa-solid fa-right-to-bracket me-1"></i> Sign In
                                </a>
                            </li>

                            <li class="nav-item mt-2 mt-lg-0">
                                <a class="btn btn-primary px-3 btn-sm fw-semibold d-inline-flex align-items-center" asp-area="" asp-controller="Account" asp-action="Register">
                                    <i class="fa-solid fa-user-plus me-1"></i> Register
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Container -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Professional Civic Footer -->
    <footer class="gcr-footer mt-auto py-5 text-white">
        <div class="container">
            <div class="row g-4 mb-4">
                <!-- Brand & Mission Column -->
                <div class="col-lg-4 col-md-6 mb-3">
                    <div class="d-flex align-items-center mb-3">
                        <span class="bg-success text-white p-2 rounded-3 me-2 d-inline-flex align-items-center justify-content-center" style="width:36px; height:36px; background-color: var(--gcr-primary-dark) !important;">
                            <i class="fa-solid fa-leaf text-warning"></i>
                        </span>
                        <h5 class="fw-bold mb-0 text-white font-display">Green City Reporter</h5>
                    </div>
                    <p class="text-white-50 small mb-3 pe-lg-3">
                        Official civic reporting platform enabling citizens to log, track, and resolve municipal environmental & infrastructure issues efficiently.
                    </p>
                </div>

                <!-- Navigation Links -->
                <div class="col-lg-3 col-md-6 col-6 mb-3">
                    <h6 class="text-white fw-bold mb-3 text-uppercase" style="letter-spacing: 0.5px; font-size: 0.85rem;">Quick Links</h6>
                    <ul class="list-unstyled footer-links small mb-0">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="mb-2"><a asp-controller="Report" asp-action="Dashboard" class="text-white-50 text-decoration-none"><i class="fa-solid fa-angle-right me-1 text-success"></i> Dashboard</a></li>
                            <li class="mb-2"><a asp-controller="Report" asp-action="Create" class="text-white-50 text-decoration-none"><i class="fa-solid fa-angle-right me-1 text-success"></i> Report Issue</a></li>
                            <li class="mb-2"><a asp-controller="Report" asp-action="MyReports" class="text-white-50 text-decoration-none"><i class="fa-solid fa-angle-right me-1 text-success"></i> My Reports</a></li>
                        }
                        else
                        {
                            <li class="mb-2"><a asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none"><i class="fa-solid fa-angle-right me-1 text-success"></i> Home</a></li>
                            <li class="mb-2"><a asp-controller="Account" asp-action="Login" class="text-white-50 text-decoration-none"><i class="fa-solid fa-angle-right me-1 text-success"></i> Sign In</a></li>
                            <li class="mb-2"><a asp-controller="Account" asp-action="Register" class="text-white-50 text-decoration-none"><i class="fa-solid fa-angle-right me-1 text-success"></i> Register</a></li>
                        }
                        <li class="mb-2"><a asp-controller="Report" asp-action="Track" class="text-white-50 text-decoration-none"><i class="fa-solid fa-angle-right me-1 text-success"></i> Track Status</a></li>
                    </ul>
                </div>

                <!-- Categories Info -->
                <div class="col-lg-2 col-md-6 col-6 mb-3">
                    <h6 class="text-white fw-bold mb-3 text-uppercase" style="letter-spacing: 0.5px; font-size: 0.85rem;">Categories</h6>
                    <ul class="list-unstyled footer-links small mb-0">
                        <li class="mb-2 text-white-50"><i class="fa-solid fa-trash me-1 text-success"></i> Waste Management</li>
                        <li class="mb-2 text-white-50"><i class="fa-solid fa-road me-1 text-warning"></i> Road Repair</li>
                        <li class="mb-2 text-white-50"><i class="fa-solid fa-droplet me-1 text-info"></i> Water Drainage</li>
                        <li class="mb-2 text-white-50"><i class="fa-solid fa-tree me-1 text-success"></i> Parks & Trees</li>
                    </ul>
                </div>

                <!-- Civic Helpline -->
                <div class="col-lg-3 col-md-6 mb-3">
                    <h6 class="text-white fw-bold mb-3 text-uppercase" style="letter-spacing: 0.5px; font-size: 0.85rem;">Civic Support</h6>
                    <div class="p-3 rounded-3 border border-secondary border-opacity-50 small" style="background-color: rgba(255, 255, 255, 0.05);">
                        <div class="d-flex align-items-center mb-1 text-white">
                            <i class="fa-solid fa-headset me-2 text-warning fs-5"></i>
                            <strong class="fs-6">Civic Helpline: 311</strong>
                        </div>
                        <p class="text-white-50 small mb-0">24/7 Hotline for urgent municipal infrastructure emergencies.</p>
                    </div>
                </div>
            </div>

            <hr class="border-secondary border-opacity-25 my-4" />

            <!-- Bottom Copyright -->
            <div class="d-flex flex-column flex-sm-row align-items-center justify-content-between small text-white-50">
                <p class="mb-2 mb-sm-0">&copy; 2026 Green City Reporter. Public Infrastructure & Civic Service Portal.</p>
                <div class="d-flex align-items-center gap-3">
                    <span class="d-inline-flex align-items-center"><span class="pulse-dot bg-success me-2"></span> System Active</span>
                </div>
            </div>
        </div>
    </footer>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <partial name="_Chatbot" />
    }

    <!-- Core Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
