@model int
@if (Model > 0)
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-4">
        <i class="fa-solid fa-users" aria-hidden="true"></i>
        <span><strong>@Model</strong> @(Model == 1 ? "other citizen supports" : "other citizens support") this issue and will receive status updates.</span>
    </div>
}
