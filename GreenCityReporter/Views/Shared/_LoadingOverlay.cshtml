<div id="site-loading" class="site-loading" hidden>
    <div class="site-loading-card">
        <div class="site-loading-icon" aria-hidden="true"><span class="site-loading-ring"></span><i class="fa-solid fa-leaf"></i></div>
        <div role="status" aria-live="polite" aria-atomic="true">
            <h2 id="site-loading-title">Loading...</h2>
            <p id="site-loading-message">Please wait while we prepare your page.</p>
        </div>
        <p id="site-loading-slow" class="site-loading-slow" hidden>This is taking a little longer. Please avoid submitting the same request again.</p>
        <button type="button" id="site-loading-dismiss">Hide loading screen</button>
        <small>Hiding this screen does not cancel your request.</small>
    </div>
</div>