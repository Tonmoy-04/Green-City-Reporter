@model GreenCityReporter.Models.Report
@using GreenCityReporter.Models.Enums
@{
    ViewData["Title"] = "Report details";
    string Label(ReportStatus status) => status == ReportStatus.InProgress ? "In progress" : status == ReportStatus.InReview ? "In review" : status.ToString();
}
<a asp-action="Index" class="back-link"><i class="fa-solid fa-arrow-left me-2" aria-hidden="true"></i> Back to reports</a>
<div class="page-heading"><div><span class="eyebrow">REPORT @Model.TrackingNumber</span><h1>Report details</h1><p class="muted">Review the issue, coordinate a response, and keep the citizen informed.</p></div><span class="status-badge status-@Model.CurrentStatus.ToString().ToLowerInvariant()">@Label(Model.CurrentStatus)</span></div>
@if (TempData["SuccessMessage"] != null) { <div class="alert alert-success" role="status">@TempData["SuccessMessage"]</div> }
<div class="report-grid">
    <div class="report-content">
        <section class="panel detail-panel">
            <div class="detail-title"><span class="count-badge">@(Model.Category?.Name ?? "Uncategorized")</span><span class="priority-label priority-@Model.Priority.ToString().ToLowerInvariant()"><i class="fa-solid fa-flag" aria-hidden="true"></i> @Model.Priority priority</span></div>
            <h2 class="issue-title">@Model.Title</h2>
            <p class="muted"><i class="fa-solid fa-location-dot me-2" aria-hidden="true"></i>@Model.Address</p>
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <img src="@Model.ImagePath" alt="Photo submitted for @Model.Title" class="report-image" />
            }
            <h3 class="field-heading">Description</h3><p class="report-copy">@Model.Description</p>
            <dl class="report-metadata"><div><dt>Submitted by</dt><dd>@(string.IsNullOrWhiteSpace(Model.User?.FullName) ? "Unknown citizen" : Model.User.FullName)</dd></div><div><dt>Submitted on</dt><dd>@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</dd></div><div><dt>Tracking number</dt><dd class="tracking">@Model.TrackingNumber</dd></div></dl>
        </section>
        <section class="panel">
            <div class="panel-heading"><div><h2><i class="fa-regular fa-comments me-2" aria-hidden="true"></i> Conversation</h2><p class="muted mb-0">Updates shared with the citizen.</p></div><span class="count-badge">@Model.Comments.Count</span></div>
            <div class="detail-panel">
                @if (TempData["CommentSuccess"] != null) { <div class="alert alert-success" role="status">@TempData["CommentSuccess"]</div> }
                @if (TempData["CommentError"] != null) { <div class="alert alert-danger" role="alert">@TempData["CommentError"]</div> }
                @if (Model.Comments.Any())
                {
                    @foreach (var comment in Model.Comments.OrderByDescending(c => c.CreatedAt))
                    {
                        <article class="comment"><div class="activity-heading"><strong>@(string.IsNullOrWhiteSpace(comment.User?.FullName) ? "Community member" : comment.User.FullName)</strong><time class="muted small">@comment.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</time></div><p class="report-copy mb-0">@comment.Message</p></article>
                    }
                }
                else
                {
                    <p class="muted">No comments yet. Share an update to start the conversation.</p>
                }
                <form asp-action="AddComment" method="post" class="comment-form">
                    <input type="hidden" name="reportId" value="@Model.Id" />
                    <label for="message" class="form-label">Add a comment</label>
                    <textarea id="message" name="message" class="form-control" rows="3" maxlength="1000" placeholder="Share an update or ask for more information…" aria-describedby="message-help" required></textarea>
                    <div id="message-help" class="form-text mb-3">Visible to the citizen. Maximum 1,000 characters.</div>
                    <button type="submit" class="btn btn-success"><i class="fa-regular fa-paper-plane me-2" aria-hidden="true"></i> Send comment</button>
                </form>
            </div>
        </section>
        <section class="panel">
            <div class="panel-heading"><div><h2><i class="fa-solid fa-clock-rotate-left me-2" aria-hidden="true"></i> Activity history</h2><p class="muted mb-0">A record of this report's progress.</p></div></div>
            <div class="detail-panel">
                @if (Model.StatusHistories.Any())
                {
                    <ol class="activity-list">
                    @foreach (var history in Model.StatusHistories.OrderByDescending(h => h.UpdatedAt))
                    {
                        <li><div class="activity-heading"><strong>@Label(history.PreviousStatus) <span class="muted mx-1">→</span> @Label(history.NewStatus)</strong><time class="muted small">@history.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</time></div><small class="muted">Updated by @(string.IsNullOrWhiteSpace(history.Updater?.FullName) ? "Administrator" : history.Updater.FullName)</small>
                        @if (!string.IsNullOrWhiteSpace(history.Remarks)) { <p class="report-copy mt-2 mb-0">@history.Remarks</p> }
                        </li>
                    }
                    </ol>
                }
                else
                {
                    <p class="muted mb-0">No status changes yet. Updates will be recorded here.</p>
                }
            </div>
        </section>
    </div>
    <aside class="report-controls">
        <section class="panel">
            <div class="panel-heading"><div><span class="eyebrow">TAKE ACTION</span><h2>Update report</h2></div><i class="fa-solid fa-sliders muted" aria-hidden="true"></i></div>
            <form asp-action="UpdateStatus" method="post" class="detail-panel">
                <input type="hidden" name="reportId" value="@Model.Id" />
                <div class="mb-4"><label for="newStatus" class="form-label">Report status</label><select id="newStatus" name="newStatus" class="form-select">
                @foreach (var status in Enum.GetValues<ReportStatus>()) { <option value="@status" selected="@(status == Model.CurrentStatus)">@Label(status)</option> }
                </select></div>
                <div class="mb-4"><label for="priority" class="form-label">Priority level</label><select id="priority" name="priority" class="form-select">
                @foreach (var priority in Enum.GetValues<Priority>()) { <option value="@priority" selected="@(priority == Model.Priority)">@priority</option> }
                </select></div>
                <div class="mb-4"><label for="remarks" class="form-label">Update notes <span class="muted fw-normal">(optional)</span></label><textarea id="remarks" name="remarks" class="form-control" rows="4" maxlength="500" placeholder="Explain what changed or outline the next steps…" aria-describedby="remarks-help"></textarea><div id="remarks-help" class="form-text">Added to the status history. Maximum 500 characters.</div></div>
                <button type="submit" class="btn btn-success w-100"><i class="fa-regular fa-floppy-disk me-2" aria-hidden="true"></i> Save changes</button>
                <p class="control-note"><i class="fa-regular fa-bell me-1" aria-hidden="true"></i> The citizen will be notified of this update.</p>
            </form>
        </section>
    </aside>
</div>
