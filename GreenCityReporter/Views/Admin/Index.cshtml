@model IEnumerable<GreenCityReporter.Models.Report>

@{
    ViewData["Title"] = "Admin Dashboard";

    var reports = Model.ToList();

    var totalReports = reports.Count;

    var pendingReports = reports.Count(r =>
        r.CurrentStatus.ToString() == "Pending");

    var assignedReports = reports.Count(r =>
        r.CurrentStatus == GreenCityReporter.Models.Enums.ReportStatus.Assigned);

    var resolvedReports = reports.Count(r =>
        r.CurrentStatus.ToString() == "Resolved");

    var highPriorityReports = reports.Count(r =>
        r.Priority.ToString() == "High" || r.Priority.ToString() == "Critical");
}

<div class="admin-dashboard container py-4">

    <!-- HERO / BANNER -->
    <section class="admin-hero mb-4">
        <div class="admin-hero-content">
            <span class="admin-eyebrow">
                <i class="fa-solid fa-shield-halved me-2"></i>
                Municipal Administration
            </span>
            <h1 class="admin-title">
                Good day, Admin.
            </h1>
            <p class="admin-subtitle">
                Monitor citizen reports, prioritize urgent hazards, and manage municipal resolution workflow.
            </p>
        </div>

        <div class="admin-hero-icon d-none d-md-block">
            <i class="fa-solid fa-leaf"></i>
        </div>
    </section>

    <!-- STAT KPI CARDS GRID -->
    <section class="admin-stat-grid mb-4">
        <!-- Total -->
        <div class="admin-stat-card stat-total">
            <div class="stat-icon">
                <i class="fa-solid fa-layer-group"></i>
            </div>
            <div>
                <span class="stat-label">Total Reports</span>
                <strong class="stat-value">@totalReports</strong>
                <span class="stat-note">Submitted issues</span>
            </div>
        </div>

        <!-- Pending -->
        <div class="admin-stat-card stat-pending">
            <div class="stat-icon">
                <i class="fa-regular fa-clock"></i>
            </div>
            <div>
                <span class="stat-label">Pending</span>
                <strong class="stat-value">@pendingReports</strong>
                <span class="stat-note">Awaiting review</span>
            </div>
        </div>

        <!-- Assigned -->
        <div class="admin-stat-card stat-progress">
            <div class="stat-icon">
                <i class="fa-solid fa-spinner"></i>
            </div>
            <div>
                <span class="stat-label">Assigned</span>
                <strong class="stat-value">@assignedReports</strong>
                <span class="stat-note">Department response</span>
            </div>
        </div>

        <!-- Resolved -->
        <div class="admin-stat-card stat-resolved">
            <div class="stat-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <div>
                <span class="stat-label">Resolved</span>
                <strong class="stat-value">@resolvedReports</strong>
                <span class="stat-note">Completed</span>
            </div>
        </div>
    </section>

    <!-- FILTER TOOLBAR CARD -->
    <div class="card mb-4 border shadow-sm">
        <div class="card-header bg-white p-3 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold mb-0 fs-6 text-dark d-flex align-items-center">
                    <i class="fa-solid fa-sliders text-success me-2"></i> Report Filter &amp; Search Controls
                </h5>
            </div>
            <div class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-3 py-1 fw-bold">
                <i class="fa-solid fa-triangle-exclamation me-1"></i> @highPriorityReports High/Critical Urgent Issues
            </div>
        </div>

        <div class="card-body p-3">
            <form asp-controller="Admin" asp-action="Index" method="get" class="row g-3">
                <div class="col-md-4">
                    <label for="priority" class="form-label fw-semibold small">Priority</label>
                    <select id="priority" name="priority" class="form-select">
                        <option value="">All Priorities</option>
                        @foreach (var priorityOption in Enum.GetValues<GreenCityReporter.Models.Enums.Priority>())
                        {
                            <option value="@priorityOption"
                                    selected="@(ViewBag.SelectedPriority == priorityOption)">
                                @priorityOption
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label for="status" class="form-label fw-semibold small">Status</label>
                    <select id="status" name="status" class="form-select">
                        <option value="">All Statuses</option>
                        @foreach (var statusOption in Enum.GetValues<GreenCityReporter.Models.Enums.ReportStatus>())
                        {
                            <option value="@statusOption"
                                    selected="@(ViewBag.SelectedStatus == statusOption)">
                                @statusOption.ToString()
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label for="categoryId" class="form-label fw-semibold small">Category</label>
                    <select id="categoryId" name="categoryId" asp-items="ViewBag.Categories" class="form-select">
                        <option value="">All Categories</option>
                    </select>
                </div>

                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-success fw-bold">
                        <i class="fa-solid fa-filter me-1"></i> Apply Filters
                    </button>
                    <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">
                        Clear Filters
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- REPORT TABLE CARD -->
    <section class="admin-table-card">
        <div class="table-card-header">
            <div class="d-flex align-items-center gap-3">
                <div class="table-title-icon">
                    <i class="fa-solid fa-list-check"></i>
                </div>
                <div>
                    <h5 class="table-title mb-0">All Citizen Reports</h5>
                    <p class="table-subtitle mb-0">Prioritized report listing</p>
                </div>
            </div>
            <span class="report-count">
                @totalReports @(totalReports == 1 ? "Report" : "Reports")
            </span>
        </div>

        @if (reports.Any())
        {
            <div class="table-responsive">
                <table class="table admin-report-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Tracking</th>
                            <th>Report Title</th>
                            <th>Category</th>
                            <th>Citizen</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Submitted</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in reports)
                        {
                            var supporterCount = (ViewData["SupportCounts"] as IReadOnlyDictionary<int, int>)?.GetValueOrDefault(report.Id) ?? 0;
                            var status = report.CurrentStatus.ToString();
                            string statusStr = status;
                            string badgeClass = status switch
                            {
                                "Pending" => "badge-pending",
                                "Assigned" => "badge-in-progress",
                                "Resolved" => "badge-resolved",
                                "Rejected" => "badge-rejected",
                                _ => "badge bg-secondary"
                            };

                            <tr>
                                <td>
                                    <span class="tracking-chip">@report.TrackingNumber</span>
                                </td>

                                <td>
                                    <div class="fw-bold text-dark">@report.Title</div>
                                    <small class="text-muted">Report #@report.Id</small>
                                    <a asp-action="Report" asp-route-id="@report.Id" asp-fragment="report-supporters" class="d-block small text-success mt-1">
                                        <i class="fa-solid fa-users me-1" aria-hidden="true"></i>@supporterCount @(supporterCount == 1 ? "supporter" : "supporters")
                                    </a>
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(report.Category?.Name ?? "Uncategorized")
                                    </span>
                                </td>

                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="rounded-circle bg-secondary text-white d-inline-flex align-items-center justify-content-center fw-bold" style="width:28px; height:28px; font-size:0.75rem;">
                                            @((report.User?.FullName ?? "U").Substring(0, 1).ToUpper())
                                        </span>
                                        <span class="small fw-semibold text-dark">
                                            @(report.User?.FullName ?? "Unknown")
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    <span class="@badgeClass">@statusStr</span>
                                </td>

                                <td>
                                    @switch (report.Priority.ToString())
                                    {
                                        case "High":
                                            <span class="badge-priority-high"><i class="fa-solid fa-arrow-up me-1"></i> High</span>
                                            break;
                                        case "Medium":
                                            <span class="badge-priority-medium"><i class="fa-solid fa-minus me-1"></i> Medium</span>
                                            break;
                                        case "Critical":
                                            <span class="badge-priority-urgent"><i class="fa-solid fa-triangle-exclamation me-1"></i> Critical</span>
                                            break;
                                        default:
                                            <span class="badge-priority-low"><i class="fa-solid fa-arrow-down me-1"></i> Low</span>
                                            break;
                                    }
                                </td>

                                <td>
                                    <small class="text-muted d-block">
                                        @report.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                    </small>
                                    <small class="text-muted" style="font-size:0.75rem;">
                                        @report.CreatedAt.ToLocalTime().ToString("hh:mm tt")
                                    </small>
                                </td>

                                <td class="text-end">
                                    <a asp-controller="Admin"
                                       asp-action="Report"
                                       asp-route-id="@report.Id"
                                       class="btn btn-sm btn-outline-success">
                                        Manage <i class="fa-solid fa-arrow-right ms-1"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="fa-regular fa-folder-open fa-3x mb-3 text-muted opacity-50"></i>
                <h5 class="fw-bold text-dark mb-1">No reports matching filters</h5>
                <p class="small mb-0">Try clearing your priority/status filters above.</p>
            </div>
        }
    </section>
</div>
