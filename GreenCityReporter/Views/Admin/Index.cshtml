@model IEnumerable<GreenCityReporter.Models.Report>

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-5">

    <div class="mb-4">
        <h1 class="fw-bold mb-1">
            Admin Dashboard
        </h1>

        <p class="text-muted mb-0">
            Manage and monitor citizen reports.
        </p>
    </div>

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="fw-bold mb-0">
                    <i class="fa-solid fa-list-check me-2 text-success"></i>
                    All Reports
                </h5>

                <span class="badge bg-success px-3 py-2">
                    @Model.Count() Reports
                </span>

            </div>

        </div>

        <div class="card-body p-0">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th class="px-4">Tracking Number</th>
                                <th>Title</th>
                                <th>Category</th>
                                <th>Citizen</th>
                                <th>Status</th>
                                <th>Priority</th>
                                <th>Date</th>
                                <th class="text-end px-4">Action</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var report in Model)
                            {
                                <tr>

                                    <td class="px-4">
                                        <span class="fw-medium text-success">
                                            @report.TrackingNumber
                                        </span>
                                    </td>

                                    <td>
                                        <span class="fw-medium">
                                            @report.Title
                                        </span>
                                    </td>

                                    <td>
                                        @report.Category?.Name
                                    </td>

                                    <td>
                                        @report.User?.FullName
                                    </td>

                                    <td>

                                        @switch (report.CurrentStatus.ToString())
                                        {
                                            case "Pending":
                                                <span class="badge bg-warning text-dark">
                                                    Pending
                                                </span>
                                                break;

                                            case "InProgress":
                                                <span class="badge bg-primary">
                                                    In Progress
                                                </span>
                                                break;

                                            case "Resolved":
                                                <span class="badge bg-success">
                                                    Resolved
                                                </span>
                                                break;

                                            case "Rejected":
                                                <span class="badge bg-danger">
                                                    Rejected
                                                </span>
                                                break;

                                            default:
                                                <span class="badge bg-secondary">
                                                    @report.CurrentStatus
                                                </span>
                                                break;
                                        }

                                    </td>

                                    <td>

                                        @switch (report.Priority.ToString())
                                        {
                                            case "High":
                                                <span class="text-danger fw-medium">
                                                    High
                                                </span>
                                                break;

                                            case "Medium":
                                                <span class="text-warning fw-medium">
                                                    Medium
                                                </span>
                                                break;

                                            default:
                                                <span class="text-success fw-medium">
                                                    Low
                                                </span>
                                                break;
                                        }

                                    </td>

                                    <td>
                                        <small class="text-muted">
                                            @report.CreatedAt
                                            .ToLocalTime()
                                            .ToString("dd MMM yyyy")
                                        </small>
                                    </td>

                                    <td class="text-end px-4">

                                        <a asp-controller="Admin"
                                           asp-action="Report"
                                           asp-route-id="@report.Id"
                                           class="btn btn-sm btn-outline-success rounded-pill px-3">

                                            <i class="fa-solid fa-eye me-1"></i>
                                            View

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="fa-solid fa-inbox fa-3x text-muted mb-3"></i>

                    <h5 class="fw-bold">
                        No reports yet
                    </h5>

                    <p class="text-muted mb-0">
                        Citizen reports will appear here.
                    </p>

                </div>
            }

        </div>

    </div>

</div>