@model IEnumerable<GreenCityReporter.Models.Report>
@using GreenCityReporter.Models.Enums
@{
    ViewData["Title"] = "Report management";
    var reports = Model.ToList();
    var pending = reports.Count(r => r.CurrentStatus == ReportStatus.Pending);
    var active = reports.Count(r => r.CurrentStatus == ReportStatus.InReview || r.CurrentStatus == ReportStatus.Assigned || r.CurrentStatus == ReportStatus.InProgress);
    var resolved = reports.Count(r => r.CurrentStatus == ReportStatus.Resolved);
    var urgent = reports.Count(r => (r.Priority == Priority.High || r.Priority == Priority.Critical) && r.CurrentStatus != ReportStatus.Resolved && r.CurrentStatus != ReportStatus.Rejected);
    string Label(ReportStatus status) => status == ReportStatus.InProgress ? "In progress" : status == ReportStatus.InReview ? "In review" : status.ToString();
}
<div class="page-heading"><div><span class="eyebrow">CITY OPERATIONS</span><h1>Reports overview</h1><p class="muted">A clear view of your city. Review, prioritize, and move issues forward.</p></div><span class="date-tag"><i class="fa-regular fa-calendar me-2" aria-hidden="true"></i>@DateTime.Now.ToString("dd MMM yyyy")</span></div>
<section class="overview-banner"><div><span class="eyebrow">MAKE AN IMPACT</span><h2>Every report deserves a response.</h2><p>Keep your community informed and focus on the issues that need you most.</p></div><div class="urgent-summary"><strong>@urgent</strong><span>high or critical priority<br />reports still open</span></div></section>
<section class="metrics" aria-label="Report statistics">
    <article class="metric"><span class="metric-icon green"><i class="fa-solid fa-layer-group" aria-hidden="true"></i></span><span>Total reports</span><strong>@reports.Count</strong><small>All citizen submissions</small></article>
    <article class="metric"><span class="metric-icon amber"><i class="fa-regular fa-clock" aria-hidden="true"></i></span><span>Awaiting review</span><strong>@pending</strong><small>Pending your attention</small></article>
    <article class="metric"><span class="metric-icon blue"><i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i></span><span>In progress</span><strong>@active</strong><small>In review, assigned, or underway</small></article>
    <article class="metric"><span class="metric-icon green"><i class="fa-regular fa-circle-check" aria-hidden="true"></i></span><span>Resolved</span><strong>@resolved</strong><small>Completed for the community</small></article>
</section>
<section class="panel" aria-labelledby="queue-title">
    <div class="panel-heading"><div><h2 id="queue-title">Report queue <span class="count-badge">@reports.Count</span></h2><p class="muted mb-0">Manage all citizen reports in one place.</p></div><span class="muted small">Newest first</span></div>
    @if (reports.Any())
    {
        <div class="queue-filters" id="queue-filters" hidden>
            <div class="search-field"><label for="report-search" class="visually-hidden">Search reports</label><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input id="report-search" class="form-control" type="search" placeholder="Search title, tracking number, or citizen…" /></div>
            <div><label for="status-filter" class="visually-hidden">Filter by status</label><select id="status-filter" class="form-select"><option value="">All statuses</option>@foreach (var status in Enum.GetValues<ReportStatus>()) { <option value="@status">@Label(status)</option> }</select></div>
            <div><label for="priority-filter" class="visually-hidden">Filter by priority</label><select id="priority-filter" class="form-select"><option value="">All priorities</option>@foreach (var priority in Enum.GetValues<Priority>()) { <option value="@priority">@priority</option> }</select></div>
            <button type="button" id="clear-filters" class="btn btn-outline-secondary">Reset</button>
        </div>
        <div class="table-responsive" tabindex="0" role="region" aria-label="Citizen reports">
            <table class="table queue-table"><thead><tr><th scope="col">Report / tracking</th><th scope="col">Citizen</th><th scope="col">Status</th><th scope="col">Priority</th><th scope="col">Submitted</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead><tbody>
                @foreach (var report in reports)
                {
                    var citizen = string.IsNullOrWhiteSpace(report.User?.FullName) ? "Unknown citizen" : report.User.FullName;
                    <tr data-report-row data-status="@report.CurrentStatus" data-priority="@report.Priority">
                        <td><a class="report-title" asp-action="Report" asp-route-id="@report.Id">@report.Title</a><div class="table-meta"><span class="tracking">@report.TrackingNumber</span><span>@(report.Category?.Name ?? "Uncategorized")</span></div></td>
                        <td><div class="citizen"><span class="account-avatar">@citizen.Substring(0, 1).ToUpperInvariant()</span><span>@citizen</span></div></td>
                        <td><span class="status-badge status-@report.CurrentStatus.ToString().ToLowerInvariant()">@Label(report.CurrentStatus)</span></td>
                        <td><span class="priority-label priority-@report.Priority.ToString().ToLowerInvariant()"><i class="fa-solid fa-flag" aria-hidden="true"></i> @report.Priority</span></td>
                        <td class="nowrap">@report.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")<small class="d-block muted">@report.CreatedAt.ToLocalTime().ToString("hh:mm tt")</small></td>
                        <td><a class="review-link" asp-action="Report" asp-route-id="@report.Id" aria-label="Review report @report.TrackingNumber">Review <i class="fa-solid fa-arrow-right ms-1" aria-hidden="true"></i></a></td>
                    </tr>
                }
            </tbody></table>
        </div>
        <div class="empty-state" id="no-results" hidden><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><h3>No matching reports</h3><p>Try another search or reset your filters.</p></div>
        <div class="queue-footer" id="report-count" role="status" aria-live="polite">Showing @reports.Count reports</div>
    }
    else
    {
        <div class="empty-state"><i class="fa-regular fa-folder-open" aria-hidden="true"></i><h3>Your report queue is clear</h3><p>New citizen reports will appear here, ready for review.</p></div>
    }
</section>
@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
}
