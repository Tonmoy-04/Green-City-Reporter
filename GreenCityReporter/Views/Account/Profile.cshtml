@model GreenCityReporter.ViewModels.UserProfileViewModel

@{
    ViewData["Title"] = "User Profile";
    string initials = !string.IsNullOrWhiteSpace(Model.FullName) ? string.Concat(Model.FullName.Split(' ').Select(s => s[0])).ToUpper() : "U";
    if (initials.Length > 2) initials = initials.Substring(0, 2);
}

<div class="container py-4">
    
    <!-- Profile Header Hero -->
    <div class="card gcr-hero-card mb-4 shadow-sm">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex flex-column flex-md-row align-items-center text-center text-md-start">
                <div class="text-white rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm me-md-4 mb-3 mb-md-0 flex-shrink-0" style="width: 80px; height: 80px; font-size: 2rem; background-color: rgba(255, 255, 255, 0.2);">
                    @initials
                </div>
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-2 mb-1">
                        <h2 class="fw-bold mb-0 text-white">@Model.FullName</h2>
                        <span class="badge bg-warning text-dark font-monospace px-3 py-1 fw-bold">
                            <i class="fa-solid fa-shield me-1"></i> @Model.Role
                        </span>
                    </div>
                    <p class="text-white-50 mb-0 small">
                        <i class="fa-regular fa-envelope me-1"></i> @Model.Email
                    </p>
                </div>
                <div class="mt-3 mt-md-0">
                    <a asp-controller="Report" asp-action="Dashboard" class="btn btn-light text-dark fw-bold">
                        <i class="fa-solid fa-chart-line me-1 text-success"></i> Go to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["ProfileSuccess"] != null)
    {
        <div class="alert alert-success py-2.5 px-3 mb-4 small d-flex align-items-center">
            <i class="fa-solid fa-circle-check me-2 fs-5"></i>
            <div>@TempData["ProfileSuccess"]</div>
        </div>
    }

    @if (TempData["PasswordSuccess"] != null)
    {
        <div class="alert alert-success py-2.5 px-3 mb-4 small d-flex align-items-center">
            <i class="fa-solid fa-key me-2 fs-5"></i>
            <div>@TempData["PasswordSuccess"]</div>
        </div>
    }

    <div class="row g-4">
        
        <!-- Left: User Overview -->
        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header bg-white p-3">
                    <h5 class="fw-bold mb-0 fs-6 text-dark">
                        <i class="fa-solid fa-user text-success me-2"></i> Account Overview
                    </h5>
                </div>
                <div class="card-body p-3">
                    <div class="mb-3 pb-3 border-bottom">
                        <small class="text-muted d-block mb-1">Full Name</small>
                        <span class="fw-semibold text-dark">@Model.FullName</span>
                    </div>
                    <div class="mb-3 pb-3 border-bottom">
                        <small class="text-muted d-block mb-1">Email Address</small>
                        <span class="fw-semibold text-dark">@Model.Email</span>
                    </div>
                    <div class="mb-3 pb-3 border-bottom">
                        <small class="text-muted d-block mb-1">Account Role</small>
                        <span class="badge bg-light text-secondary border">@Model.Role</span>
                    </div>
                    <div>
                        <small class="text-muted d-block mb-1">Total Reports Submitted</small>
                        <span class="fw-bold text-success">@Model.TotalReportsCount Reports</span>
                        <small class="text-muted d-block">(@Model.ResolvedReportsCount resolved)</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Edit Profile & Password -->
        <div class="col-lg-8">
            
            <!-- Update Full Name Card -->
            <div class="card mb-4">
                <div class="card-header bg-white p-3">
                    <h5 class="fw-bold mb-0 fs-6 text-dark">
                        <i class="fa-solid fa-pen-to-square text-success me-2"></i> Personal Information
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Account" asp-action="Profile" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label">Full Name</label>
                            <input asp-for="FullName" class="form-control" placeholder="Enter your full name" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email Address</label>
                            <input value="@Model.Email" class="form-control bg-light" disabled />
                            <div class="form-text">Email address cannot be changed directly.</div>
                        </div>

                        <button type="submit" class="btn btn-success fw-bold px-4">
                            <i class="fa-solid fa-floppy-disk me-1"></i> Save Changes
                        </button>
                    </form>
                </div>
            </div>

            <!-- Change Password Card -->
            <div class="card">
                <div class="card-header bg-white p-3">
                    <h5 class="fw-bold mb-0 fs-6 text-dark">
                        <i class="fa-solid fa-lock text-success me-2"></i> Security &amp; Password
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Account" asp-action="Profile" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="FullName" value="@Model.FullName" />

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label">Current Password</label>
                            <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="Enter current password" />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="NewPassword" class="form-label">New Password</label>
                                <input asp-for="NewPassword" type="password" class="form-control" placeholder="Enter new password" />
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ConfirmNewPassword" class="form-label">Confirm New Password</label>
                                <input asp-for="ConfirmNewPassword" type="password" class="form-control" placeholder="Confirm new password" />
                                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-outline-success fw-bold px-4">
                            <i class="fa-solid fa-key me-1"></i> Update Password
                        </button>
                    </form>
                </div>
            </div>

        </div>

    </div>
</div>
