@model GreenCityReporter.ViewModels.UserProfileViewModel

@{
    ViewData["Title"] = "User Profile";
    string initials = !string.IsNullOrWhiteSpace(Model.FullName) ? string.Concat(Model.FullName.Split(' ').Select(s => s[0])).ToUpper() : "U";
    if (initials.Length > 2) initials = initials.Substring(0, 2);
}

<div class="container py-5">
    
    <!-- Profile Header Hero -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex flex-column flex-md-row align-items-center">
                <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm me-md-4 mb-3 mb-md-0" style="width: 90px; height: 90px; font-size: 2.2rem;">
                    @initials
                </div>
                <div class="text-center text-md-start flex-grow-1">
                    <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-2 mb-1">
                        <h2 class="fw-bold mb-0 text-dark">@Model.FullName</h2>
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-1 rounded-pill">
                            <i class="fa-solid fa-shield me-1"></i> @Model.Role
                        </span>
                    </div>
                    <p class="text-muted mb-0">
                        <i class="fa-regular fa-envelope me-1"></i> @Model.Email
                    </p>
                </div>
                <div class="mt-3 mt-md-0 text-center text-md-end">
                    <a asp-controller="Report" asp-action="Dashboard" class="btn btn-outline-success rounded-pill px-4">
                        <i class="fa-solid fa-chart-line me-2"></i> Go to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["ProfileSuccess"] != null)
    {
        <div class="alert alert-success rounded-3 mb-4">
            <i class="fa-solid fa-check-circle me-2"></i> @TempData["ProfileSuccess"]
        </div>
    }

    @if (TempData["PasswordSuccess"] != null)
    {
        <div class="alert alert-success rounded-3 mb-4">
            <i class="fa-solid fa-key me-2"></i> @TempData["PasswordSuccess"]
        </div>
    }

    <div class="row g-4">
        
        <!-- Left: User Overview -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 p-4 pb-0">
                    <h5 class="fw-bold mb-0">
                        <i class="fa-solid fa-user text-success me-2"></i> Account Details
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3 pb-3 border-bottom">
                        <small class="text-muted d-block mb-1">Full Name</small>
                        <span class="fw-medium text-dark">@Model.FullName</span>
                    </div>
                    <div class="mb-3 pb-3 border-bottom">
                        <small class="text-muted d-block mb-1">Email Address</small>
                        <span class="fw-medium text-dark">@Model.Email</span>
                    </div>
                    <div class="mb-3 pb-3 border-bottom">
                        <small class="text-muted d-block mb-1">Account Role</small>
                        <span class="badge bg-light text-secondary border">@Model.Role</span>
                    </div>
                    <div>
                        <small class="text-muted d-block mb-1">Total Reports Submitted</small>
                        <span class="fw-bold text-success">@Model.TotalReportsCount Reports</span>
                        <small class="text-muted d-block">(@Model.ResolvedReportsCount resolved)</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Edit Profile & Password -->
        <div class="col-lg-8">
            
            <!-- Update Full Name Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 p-4 pb-0">
                    <h5 class="fw-bold mb-0">
                        <i class="fa-solid fa-pen-to-square text-success me-2"></i> Edit Personal Information
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Account" asp-action="Profile" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-medium">Full Name</label>
                            <input asp-for="FullName" class="form-control form-control-lg" placeholder="Enter your full name" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-medium">Email Address</label>
                            <input value="@Model.Email" class="form-control form-control-lg bg-light" disabled />
                            <div class="form-text">Email address cannot be changed directly.</div>
                        </div>

                        <button type="submit" class="btn btn-success rounded-pill px-4">
                            <i class="fa-solid fa-floppy-disk me-2"></i> Save Changes
                        </button>
                    </form>
                </div>
            </div>

            <!-- Change Password Card -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 p-4 pb-0">
                    <h5 class="fw-bold mb-0">
                        <i class="fa-solid fa-lock text-success me-2"></i> Change Password
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Account" asp-action="Profile" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="FullName" value="@Model.FullName" />

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label fw-medium">Current Password</label>
                            <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="Enter current password" />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="NewPassword" class="form-label fw-medium">New Password</label>
                                <input asp-for="NewPassword" type="password" class="form-control" placeholder="Enter new password" />
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ConfirmNewPassword" class="form-label fw-medium">Confirm New Password</label>
                                <input asp-for="ConfirmNewPassword" type="password" class="form-control" placeholder="Confirm new password" />
                                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-outline-success rounded-pill px-4">
                            <i class="fa-solid fa-key me-2"></i> Update Password
                        </button>
                    </form>
                </div>
            </div>

        </div>

    </div>
</div>
