@model bool
@{
    ViewData["Title"] = Model ? "Email Verified" : "Verification Failed";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-body p-4 p-md-5 text-center">
                    @if (Model)
                    {
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-4 text-success" style="width:72px;height:72px;background:var(--primary-light)">
                            <i class="fa-solid fa-circle-check fa-2x"></i>
                        </div>
                        <h1 class="h3 fw-bold mb-3">Email address verified</h1>
                        <p class="text-muted">Your Green City Reporter account is active. You can now sign in.</p>
                        <a asp-action="Login" class="btn btn-success px-4 mt-2">Sign In</a>
                    }
                    else
                    {
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-4 text-danger bg-danger-subtle" style="width:72px;height:72px">
                            <i class="fa-solid fa-circle-exclamation fa-2x"></i>
                        </div>
                        <h1 class="h3 fw-bold mb-3">Verification link not accepted</h1>
                        <p class="text-muted">This link is invalid or no longer usable. Request a new verification email and try again.</p>
                        <a asp-action="ResendVerificationEmail" class="btn btn-success px-4 mt-2">Resend Verification Email</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
