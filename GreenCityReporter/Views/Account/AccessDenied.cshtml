@{
	ViewData["Title"] = "Access Denied";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card text-center p-4 p-md-5">
                <div class="empty-state-icon mx-auto mb-3"><i class="fa-solid fa-lock"></i></div>
                <h1 class="h3 fw-bold mb-2">Access denied</h1>
                <p class="text-muted mb-4">You do not have permission to access this resource.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Return to Home</a>
            </div>
        </div>
    </div>
</div>
