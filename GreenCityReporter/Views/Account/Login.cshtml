@model GreenCityReporter.ViewModels.LoginViewModel
@{
	ViewData["Title"] = "Log in";
}

<div class="container py-5">
	<div class="row justify-content-center">
		<div class="col-md-6 col-lg-5">
			<div class="card border mb-4">
				<div class="card-body p-4 p-md-5">
					<div class="text-center mb-4">
						<div class="rounded-circle d-inline-flex align-items-center justify-content-center p-3 mb-2 text-success" style="width: 56px; height: 56px; background-color: var(--gcr-secondary-light);">
							<i class="fa-solid fa-leaf fa-xl"></i>
						</div>
						<h3 class="fw-bold text-dark mb-1">Citizen Portal Log In</h3>
						<p class="text-muted small mb-0">Sign in to manage and track your civic reports.</p>
					</div>

					<form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
						<div asp-validation-summary="All" class="text-danger small mb-3"></div>

						<div class="form-floating mb-3">
							<input asp-for="Email" class="form-control" placeholder="name@example.com" required />
							<label asp-for="Email">Email address</label>
							<span asp-validation-for="Email" class="text-danger small"></span>
						</div>

						<div class="form-floating mb-3">
							<input asp-for="Password" class="form-control" placeholder="Password" required />
							<label asp-for="Password">Password</label>
							<span asp-validation-for="Password" class="text-danger small"></span>
						</div>

						<div class="form-check mb-4">
							<input asp-for="RememberMe" class="form-check-input" />
							<label asp-for="RememberMe" class="form-check-label text-dark small">Remember me on this browser</label>
						</div>

						<button type="submit" class="btn btn-success w-100 py-2.5 fw-bold">Sign In</button>

						<div class="text-center mt-4 pt-3 border-top">
							<p class="mb-0 text-muted small">Don't have an account yet? <a asp-action="Register" class="text-success fw-bold text-decoration-none">Register here</a></p>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}