@{
    ViewData["Title"] = "Privacy Policy";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="page-intro mb-4">
                <span class="eyebrow"><i class="fa-solid fa-shield-halved me-2"></i>Green City Reporter</span>
                <h1 class="display-6 fw-bold mb-2">@ViewData["Title"]</h1>
                <p class="text-muted mb-0">How this civic reporting portal handles information and public service requests.</p>
            </div>
            <article class="card p-4 p-md-5">
                <h2 class="h5 fw-bold">Your privacy matters</h2>
                <p class="text-muted mb-0">Use this page to detail your site's privacy policy.</p>
            </article>
        </div>
    </div>
</div>
