@{
    ViewData["Title"] = "Civic Infrastructure & Environmental Reporting";
}

<!-- Hero Section -->
<div class="py-5" style="background: linear-gradient(180deg, #f0f7f3 0%, var(--gcr-bg) 100%); border-bottom: 1px solid var(--gcr-border);">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-7 text-center text-lg-start">
                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill mb-3 fw-bold">
                    <i class="fa-solid fa-leaf me-1 text-warning"></i> Sustainable Civic Technology Initiative
                </span>
                <h1 class="display-4 fw-bold text-dark lh-sm mb-3">
                    Empowering Citizens to Build a <span class="text-success" style="color: var(--gcr-primary-emerald) !important;">Cleaner, Safer City</span>
                </h1>
                <p class="lead text-muted mb-4 pe-lg-4 fs-5">
                    Green City Reporter provides a seamless platform for citizens to report municipal infrastructure issues, waste management hazards, and environmental concerns directly to city authorities.
                </p>
                <div class="d-flex flex-column flex-sm-row justify-content-center justify-content-lg-start gap-3 mb-4">
                    <a asp-controller="Report" asp-action="Create" class="btn btn-success btn-lg px-4 py-3 fw-bold">
                        <i class="fa-solid fa-bullhorn me-2"></i> Report an Issue
                    </a>
                    <a asp-controller="Report" asp-action="Track" class="btn btn-outline-secondary btn-lg px-4 py-3 fw-bold">
                        <i class="fa-solid fa-magnifying-glass me-2 text-success"></i> Track Report Status
                    </a>
                </div>

                <div class="row pt-4 border-top text-center text-lg-start g-3">
                    <div class="col-4">
                        <h3 class="fw-bold text-dark mb-0 font-monospace">1.2K+</h3>
                        <p class="text-muted small mb-0 fw-semibold">Issues Resolved</p>
                    </div>
                    <div class="col-4 border-start border-end">
                        <h3 class="fw-bold text-dark mb-0 font-monospace">24h</h3>
                        <p class="text-muted small mb-0 fw-semibold">Average Response</p>
                    </div>
                    <div class="col-4">
                        <h3 class="fw-bold text-dark mb-0 font-monospace">8K+</h3>
                        <p class="text-muted small mb-0 fw-semibold">Active Citizens</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="card-header bg-white p-4 border-bottom">
                        <h5 class="fw-bold mb-0 text-dark d-flex align-items-center">
                            <i class="fa-solid fa-bolt text-warning me-2"></i> Live Civic Monitoring
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex mb-3.5 p-3 rounded-3 bg-light border">
                            <div class="rounded-3 p-3 me-3 text-danger d-flex align-items-center justify-content-center" style="background-color: #fee2e2; width: 48px; height: 48px;">
                                <i class="fa-solid fa-road fa-lg"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 text-dark">Road Damage &amp; Pothole</h6>
                                <p class="text-muted small mb-0">Banani, Dhaka &bull; <span class="badge-in-progress">In Progress</span></p>
                            </div>
                        </div>

                        <div class="d-flex mb-3.5 p-3 rounded-3 bg-light border">
                            <div class="rounded-3 p-3 me-3 text-success d-flex align-items-center justify-content-center" style="background-color: #dcfce7; width: 48px; height: 48px;">
                                <i class="fa-solid fa-trash fa-lg"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 text-dark">Overflowing Waste Bin</h6>
                                <p class="text-muted small mb-0">Dhanmondi, Dhaka &bull; <span class="badge-resolved">Resolved</span></p>
                            </div>
                        </div>

                        <div class="d-flex p-3 rounded-3 bg-light border">
                            <div class="rounded-3 p-3 me-3 text-info d-flex align-items-center justify-content-center" style="background-color: #e0f2fe; width: 48px; height: 48px;">
                                <i class="fa-solid fa-droplet fa-lg"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 text-dark">Water Logging &amp; Drainage</h6>
                                <p class="text-muted small mb-0">Mirpur, Dhaka &bull; <span class="badge-pending">Under Review</span></p>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-light border-top text-center py-3">
                        <a asp-controller="Account" asp-action="Login" class="text-decoration-none text-success fw-bold small">
                            Sign in to log and monitor your issues <i class="fa-solid fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Key Platform Capabilities -->
<div class="py-5">
    <div class="container py-3">
        <div class="text-center max-w-2xl mx-auto mb-5">
            <span class="text-success fw-bold text-uppercase small" style="letter-spacing: 1px;">Key Capabilities</span>
            <h2 class="fw-bold text-dark mt-1">Smart Public Infrastructure Reporting</h2>
            <p class="text-muted">Designed for fast issue logging, transparent tracking, and automated AI assistance.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card h-100">
                    <div class="feature-icon-wrapper">
                        <i class="fa-solid fa-map-location-dot"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Pinpoint Map Location</h5>
                    <p class="text-muted small mb-0">Interactive Leaflet map boundary tool ensuring precise Dhaka location coordinates for municipal field teams.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card h-100">
                    <div class="feature-icon-wrapper" style="background-color: #fef9c3; color: var(--gcr-accent-gold);">
                        <i class="fa-solid fa-robot"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">AI Assisted Processing</h5>
                    <p class="text-muted small mb-0">Smart classification, priority estimation, and automated summary generation to accelerate response times.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card h-100">
                    <div class="feature-icon-wrapper" style="background-color: #e0f2fe; color: #0284c7;">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Transparent Progress</h5>
                    <p class="text-muted small mb-0">Real-time status updates, notification alerts, and official comment history from city administration.</p>
                </div>
            </div>
        </div>
    </div>
</div>
