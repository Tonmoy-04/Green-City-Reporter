@model IEnumerable<GreenCityReporter.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
    var unreadList = Model.Where(n => !n.IsRead).ToList();
    var readList = Model.Where(n => n.IsRead).ToList();
    var unreadCount = unreadList.Count;
}

<div class="container py-4">

    <!-- Header Hero Banner -->
    <div class="card gcr-hero-card mb-4 shadow-sm">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between">
                <div class="d-flex align-items-center mb-3 mb-md-0">
                    <span class="rounded-circle p-3 me-3 d-inline-flex align-items-center justify-content-center text-white flex-shrink-0" style="width: 52px; height: 52px; background-color: rgba(255, 255, 255, 0.15);">
                        <i class="fa-solid fa-bell fa-xl text-warning"></i>
                    </span>
                    <div>
                        <h2 class="fw-bold mb-0 text-white">Notification Center</h2>
                        <p class="text-white-50 mb-0 small">Real-time alerts and official updates on your civic reports</p>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    @if (unreadCount > 0)
                    {
                        <span class="badge bg-warning text-dark px-3 py-2 fw-bold">
                            @unreadCount Unread
                        </span>
                        <form asp-controller="Notification" asp-action="MarkAllAsRead" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-light text-dark fw-bold btn-sm">
                                <i class="fa-solid fa-check-double me-1 text-success"></i> Mark All Read
                            </button>
                        </form>
                    }
                    else
                    {
                        <span class="badge bg-white bg-opacity-20 text-white px-3 py-2">
                            <i class="fa-solid fa-check-circle me-1 text-warning"></i> All Caught Up
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card text-center py-5">
            <div class="card-body py-5">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center p-4 mb-3 text-success" style="width: 72px; height: 72px; background-color: var(--primary-light);">
                    <i class="fa-regular fa-bell-slash fa-2x"></i>
                </div>
                <h4 class="fw-bold text-dark">No Notifications</h4>
                <p class="text-muted small mb-4">
                    When municipal staff update your reports or post official comments, alerts will appear here.
                </p>
                <a asp-controller="Report" asp-action="Create" class="btn btn-success">
                    <i class="fa-solid fa-bullhorn me-1"></i> Report an Issue
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var notification in Model)
            {
                string msg = notification.Message;
                string iconClass = "fa-bell text-primary";
                string iconBg = "bg-light";
                string cardBorder = notification.IsRead ? "border" : "border border-success border-2 shadow-sm";

                if (msg.Contains("Resolved", StringComparison.OrdinalIgnoreCase))
                {
                    iconClass = "fa-circle-check text-success";
                    iconBg = "bg-success bg-opacity-10";
                }
                else if (msg.Contains("In Progress", StringComparison.OrdinalIgnoreCase))
                {
                    iconClass = "fa-bars-progress text-primary";
                    iconBg = "bg-primary bg-opacity-10";
                }
                else if (msg.Contains("Rejected", StringComparison.OrdinalIgnoreCase))
                {
                    iconClass = "fa-circle-xmark text-danger";
                    iconBg = "bg-danger bg-opacity-10";
                }
                else if (msg.Contains("commented", StringComparison.OrdinalIgnoreCase) || msg.Contains("comment", StringComparison.OrdinalIgnoreCase))
                {
                    iconClass = "fa-comments text-warning";
                    iconBg = "bg-warning bg-opacity-10";
                }

                <div class="col-12">
                    <div class="card @cardBorder">
                        <div class="card-body p-3.5">
                            <div class="d-flex flex-column flex-md-row align-items-start justify-content-between gap-3">
                                
                                <div class="d-flex align-items-start gap-3">
                                    <div class="rounded-circle p-2.5 d-flex align-items-center justify-content-center @iconBg flex-shrink-0" style="width: 44px; height: 44px;">
                                        <i class="fa-solid @iconClass fs-5"></i>
                                    </div>

                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            @if (!notification.IsRead)
                                            {
                                                <span class="badge bg-danger px-2 py-0.5" style="font-size: 0.65rem;">NEW</span>
                                            }
                                            <small class="text-muted">
                                                <i class="fa-regular fa-clock me-1"></i>
                                                @notification.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                            </small>
                                        </div>

                                        <h6 class="fw-bold mb-1 text-dark">
                                            @notification.Message
                                        </h6>

                                        @if (notification.Report != null)
                                        {
                                            <small class="text-muted d-block">
                                                <i class="fa-solid fa-hashtag me-1"></i> Tracking #: <span class="tracking-chip">@notification.Report.TrackingNumber</span> &bull; @notification.Report.Title
                                            </small>
                                        }
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div class="d-flex align-items-center gap-2 align-self-md-center ms-auto ms-md-0">
                                    @if (notification.ReportId > 0)
                                    {
                                        <a asp-controller="Report" asp-action="Details" asp-route-id="@notification.ReportId" class="btn btn-sm btn-outline-success fw-semibold">
                                            <i class="fa-solid fa-eye me-1"></i> View Report
                                        </a>
                                    }

                                    @if (!notification.IsRead)
                                    {
                                        <form asp-controller="Notification" asp-action="MarkAsRead" asp-route-id="@notification.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-secondary" title="Mark as read">
                                                <i class="fa-solid fa-check me-1"></i> Read
                                            </button>
                                        </form>
                                    }
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>
