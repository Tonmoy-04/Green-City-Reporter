@model IEnumerable<GreenCityReporter.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
    var unreadList = Model.Where(n => !n.IsRead).ToList();
    var readList = Model.Where(n => n.IsRead).ToList();
    var unreadCount = unreadList.Count;
}

<div class="container py-5">

    <!-- Header Hero Banner -->
    <div class="card border-0 shadow-sm rounded-4 text-white mb-4" style="background: linear-gradient(135deg, #059669 0%, #10b981 50%, #06b6d4 100%);">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between">
                <div>
                    <div class="d-flex align-items-center mb-2">
                        <span class="bg-white bg-opacity-25 rounded-circle p-3 me-3 d-inline-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                            <i class="fa-solid fa-bell fa-xl text-white"></i>
                        </span>
                        <div>
                            <h2 class="fw-bold mb-0">Notification Center</h2>
                            <p class="text-white-50 mb-0">Real-time updates on your reported environmental issues</p>
                        </div>
                    </div>
                </div>

                <div class="mt-3 mt-md-0 d-flex align-items-center gap-2">
                    @if (unreadCount > 0)
                    {
                        <span class="badge bg-white text-dark px-3 py-2 rounded-pill fw-bold shadow-sm">
                            <i class="fa-solid fa-circle fa-2xs text-danger me-1"></i> @unreadCount Unread
                        </span>
                        <form asp-controller="Notification" asp-action="MarkAllAsRead" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-light text-success fw-semibold rounded-pill px-4 shadow-sm">
                                <i class="fa-solid fa-check-double me-2"></i> Mark All Read
                            </button>
                        </form>
                    }
                    else
                    {
                        <span class="badge bg-white bg-opacity-25 text-white px-3 py-2 rounded-pill">
                            <i class="fa-solid fa-check-circle me-1"></i> All Caught Up
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5">
            <div class="card-body py-5">
                <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex align-items-center justify-content-center p-4 mb-3" style="width: 80px; height: 80px;">
                    <i class="fa-regular fa-bell-slash fa-2x"></i>
                </div>
                <h4 class="fw-bold text-dark">No Notifications Yet</h4>
                <p class="text-muted mb-4">
                    When admins update your reports or add comments, you'll see alerts here.
                </p>
                <a asp-controller="Report" asp-action="Create" class="btn btn-success rounded-pill px-4 py-2">
                    <i class="fa-solid fa-bullhorn me-2"></i> Report an Issue
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var notification in Model)
            {
                string msg = notification.Message;
                string iconClass = "fa-bell";
                string iconBg = "bg-primary bg-opacity-10 text-primary";
                string cardBorder = "border-start border-4 border-primary";
                string cardBg = notification.IsRead ? "bg-white" : "bg-light-subtle";

                if (msg.Contains("Resolved", StringComparison.OrdinalIgnoreCase))
                {
                    iconClass = "fa-circle-check";
                    iconBg = "bg-success bg-opacity-10 text-success";
                    cardBorder = "border-start border-4 border-success";
                }
                else if (msg.Contains("In Progress", StringComparison.OrdinalIgnoreCase))
                {
                    iconClass = "fa-bars-progress";
                    iconBg = "bg-primary bg-opacity-10 text-primary";
                    cardBorder = "border-start border-4 border-primary";
                }
                else if (msg.Contains("Rejected", StringComparison.OrdinalIgnoreCase))
                {
                    iconClass = "fa-circle-xmark";
                    iconBg = "bg-danger bg-opacity-10 text-danger";
                    cardBorder = "border-start border-4 border-danger";
                }
                else if (msg.Contains("commented", StringComparison.OrdinalIgnoreCase) || msg.Contains("comment", StringComparison.OrdinalIgnoreCase))
                {
                    iconClass = "fa-comments";
                    iconBg = "bg-warning bg-opacity-10 text-warning-emphasis";
                    cardBorder = "border-start border-4 border-warning";
                }

                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 @cardBg @(!notification.IsRead ? cardBorder : "") transition-all">
                        <div class="card-body p-4">
                            <div class="d-flex flex-column flex-md-row align-items-start justify-content-between gap-3">
                                
                                <div class="d-flex align-items-start gap-3">
                                    <!-- Colorful Icon Box -->
                                    <div class="rounded-4 p-3 d-flex align-items-center justify-content-center @iconBg flex-shrink-0" style="width: 52px; height: 52px;">
                                        <i class="fa-solid @iconClass fa-lg"></i>
                                    </div>

                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            @if (!notification.IsRead)
                                            {
                                                <span class="badge bg-danger rounded-pill px-2 py-1" style="font-size: 0.65rem;">NEW</span>
                                            }
                                            <small class="text-muted fw-medium">
                                                <i class="fa-regular fa-clock me-1"></i>
                                                @notification.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                            </small>
                                        </div>

                                        <h6 class="fw-bold mb-1 text-dark @(!notification.IsRead ? "fw-bold" : "fw-normal")">
                                            @notification.Message
                                        </h6>

                                        @if (notification.Report != null)
                                        {
                                            <small class="text-muted">
                                                <i class="fa-solid fa-hashtag me-1"></i> Report: <span class="text-success fw-medium">@notification.Report.TrackingNumber</span> - @notification.Report.Title
                                            </small>
                                        }
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div class="d-flex align-items-center gap-2 align-self-md-center ms-auto ms-md-0">
                                    @if (notification.ReportId > 0)
                                    {
                                        <a asp-controller="Report" asp-action="Details" asp-route-id="@notification.ReportId" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-medium">
                                            <i class="fa-solid fa-eye me-1"></i> View Report
                                        </a>
                                    }

                                    @if (!notification.IsRead)
                                    {
                                        <form asp-controller="Notification" asp-action="MarkAsRead" asp-route-id="@notification.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-light border text-secondary rounded-pill px-3" title="Mark as read">
                                                <i class="fa-solid fa-check me-1"></i> Read
                                            </button>
                                        </form>
                                    }
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>
