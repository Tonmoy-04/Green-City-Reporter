@model GreenCityReporter.ViewModels.CitizenDashboardViewModel

@{
    ViewData["Title"] = "Citizen Dashboard";
}

<div class="container py-4">

    <!-- Welcome Hero Banner -->
    <div class="card gcr-hero-card mb-4 shadow-sm">
        <div class="card-body p-4 p-md-5">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <span class="badge bg-white bg-opacity-20 text-white px-3 py-2 rounded-pill mb-3 fw-semibold">
                        <i class="fa-solid fa-leaf me-1 text-warning"></i> Citizen Service Dashboard
                    </span>
                    <h1 class="fw-bold mb-2 text-white">Welcome Back!</h1>
                    <p class="lead mb-0 text-white-50 fs-6">
                        Monitor your civic submissions, track municipal resolution progress, and stay updated on local environmental reports.
                    </p>
                </div>
                <div class="col-md-4 text-center text-md-end mt-4 mt-md-0">
                    <a asp-controller="Report" asp-action="Create" class="btn btn-warning text-dark fw-bold rounded-2 px-4 py-3 shadow-sm">
                        <i class="fa-solid fa-circle-plus me-2"></i> Report New Issue
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Stat KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card h-100 p-3 border">
                <div class="d-flex align-items-center">
                    <div class="rounded-3 p-3 me-3 text-success" style="background-color: var(--gcr-secondary-light);">
                        <i class="fa-solid fa-folder-open fa-2x"></i>
                    </div>
                    <div>
                        <small class="text-muted fw-bold text-uppercase d-block" style="font-size: 0.75rem; letter-spacing: 0.5px;">Total Reports</small>
                        <h2 class="fw-bold mb-0 text-dark">@Model.TotalReports</h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card h-100 p-3 border">
                <div class="d-flex align-items-center">
                    <div class="rounded-3 p-3 me-3" style="background-color: var(--gcr-pending-bg); color: var(--gcr-pending-text);">
                        <i class="fa-regular fa-clock fa-2x"></i>
                    </div>
                    <div>
                        <small class="text-muted fw-bold text-uppercase d-block" style="font-size: 0.75rem; letter-spacing: 0.5px;">Pending</small>
                        <h2 class="fw-bold mb-0 text-dark">@Model.PendingCount</h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card h-100 p-3 border">
                <div class="d-flex align-items-center">
                    <div class="rounded-3 p-3 me-3" style="background-color: var(--gcr-progress-bg); color: var(--gcr-progress-text);">
                        <i class="fa-solid fa-spinner fa-2x"></i>
                    </div>
                    <div>
                        <small class="text-muted fw-bold text-uppercase d-block" style="font-size: 0.75rem; letter-spacing: 0.5px;">In Progress</small>
                        <h2 class="fw-bold mb-0 text-dark">@Model.InProgressCount</h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card h-100 p-3 border">
                <div class="d-flex align-items-center">
                    <div class="rounded-3 p-3 me-3" style="background-color: var(--gcr-resolved-bg); color: var(--gcr-resolved-text);">
                        <i class="fa-solid fa-circle-check fa-2x"></i>
                    </div>
                    <div>
                        <small class="text-muted fw-bold text-uppercase d-block" style="font-size: 0.75rem; letter-spacing: 0.5px;">Resolved</small>
                        <h2 class="fw-bold mb-0 text-dark">@Model.ResolvedCount</h2>
                    </div>
                </div>
                <div class="progress mt-3" style="height: 6px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: @Model.ResolutionRate%" aria-valuenow="@Model.ResolutionRate" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <small class="text-muted text-end d-block mt-1" style="font-size: 0.7rem;">@Model.ResolutionRate.ToString("0.#")% Resolution Rate</small>
            </div>
        </div>
    </div>

    <!-- Main Content Row -->
    <div class="row g-4">
        
        <!-- Left Column: Recent Submissions & Notifications Feed -->
        <div class="col-lg-8">
            
            <!-- Recent Submissions Table Card -->
            <div class="card mb-4">
                <div class="card-header bg-white p-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 fs-6 text-dark d-flex align-items-center">
                        <i class="fa-solid fa-clock-rotate-left text-success me-2"></i> Recent Submissions
                    </h5>
                    <a asp-controller="Report" asp-action="MyReports" class="btn btn-sm btn-outline-success">
                        View All Reports
                    </a>
                </div>
                <div class="card-body p-0">
                    @if (!Model.RecentReports.Any())
                    {
                        <div class="text-center py-5 px-3">
                            <i class="fa-regular fa-folder-open fa-3x text-muted mb-3 opacity-50"></i>
                            <h5 class="fw-semibold text-dark mb-1">No Reports Submitted Yet</h5>
                            <p class="text-muted small mb-3">Report environmental & civic issues in your neighborhood to initiate action.</p>
                            <a asp-controller="Report" asp-action="Create" class="btn btn-success">
                                <i class="fa-solid fa-plus me-1"></i> Submit Report
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Tracking #</th>
                                        <th>Title</th>
                                        <th>Category</th>
                                        <th>Status</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var report in Model.RecentReports)
                                    {
                                        string statusStr = report.CurrentStatus.ToString() == "InProgress" ? "In Progress" : report.CurrentStatus.ToString();
                                        string badgeClass = report.CurrentStatus.ToString() switch
                                        {
                                            "Pending" => "badge-pending",
                                            "InProgress" => "badge-in-progress",
                                            "Resolved" => "badge-resolved",
                                            "Rejected" => "badge-rejected",
                                            _ => "badge bg-secondary"
                                        };

                                        <tr>
                                            <td>
                                                <span class="fw-bold font-monospace text-success small">@report.TrackingNumber</span>
                                            </td>
                                            <td class="fw-semibold text-dark">@report.Title</td>
                                            <td><span class="badge bg-light text-dark border">@(report.Category?.Name ?? "General")</span></td>
                                            <td><span class="@badgeClass">@statusStr</span></td>
                                            <td class="text-end">
                                                <a asp-controller="Report" asp-action="Details" asp-route-id="@report.Id" class="btn btn-sm btn-outline-success">
                                                    Details
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- Recent Notifications Widget Card -->
            <div class="card mb-4">
                <div class="card-header bg-white p-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 fs-6 text-dark d-flex align-items-center">
                        <i class="fa-solid fa-bell text-success me-2"></i> Recent Notifications
                        @if (Model.UnreadNotificationCount > 0)
                        {
                            <span class="badge bg-danger ms-2" style="font-size: 0.7rem;">@Model.UnreadNotificationCount NEW</span>
                        }
                    </h5>
                    <a asp-controller="Notification" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        View All
                    </a>
                </div>
                <div class="card-body p-3">
                    @if (!Model.RecentNotifications.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="fa-regular fa-bell fa-2x mb-2 text-muted opacity-50"></i>
                            <p class="mb-0 small">No notifications yet. You will be alerted when admins update your reports.</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var notif in Model.RecentNotifications)
                            {
                                string msg = notif.Message;
                                string iconClass = "fa-bell text-primary";
                                string bgBadge = "bg-light";

                                if (msg.Contains("Resolved", StringComparison.OrdinalIgnoreCase))
                                {
                                    iconClass = "fa-circle-check text-success";
                                    bgBadge = "bg-success bg-opacity-10";
                                }
                                else if (msg.Contains("In Progress", StringComparison.OrdinalIgnoreCase))
                                {
                                    iconClass = "fa-bars-progress text-primary";
                                    bgBadge = "bg-primary bg-opacity-10";
                                }
                                else if (msg.Contains("comment", StringComparison.OrdinalIgnoreCase))
                                {
                                    iconClass = "fa-comments text-warning";
                                    bgBadge = "bg-warning bg-opacity-10";
                                }

                                <div class="list-group-item px-0 py-3 d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center me-3">
                                        <div class="rounded-circle p-2 me-3 d-flex align-items-center justify-content-center @bgBadge" style="width: 38px; height: 38px;">
                                            <i class="fa-solid @iconClass"></i>
                                        </div>
                                        <div>
                                            <p class="mb-0 text-dark @(!notif.IsRead ? "fw-bold" : "fw-normal")" style="font-size: 0.9rem;">
                                                @notif.Message
                                            </p>
                                            <small class="text-muted" style="font-size: 0.75rem;">
                                                <i class="fa-regular fa-clock me-1"></i>@notif.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                            </small>
                                        </div>
                                    </div>
                                    @if (notif.ReportId > 0)
                                    {
                                        <a asp-controller="Report" asp-action="Details" asp-route-id="@notif.ReportId" class="btn btn-sm btn-outline-secondary flex-shrink-0">
                                            View
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

        </div>

        <!-- Right Column: Quick Shortcuts & Category Breakdown -->
        <div class="col-lg-4">
            
            <!-- Quick Actions Card -->
            <div class="card mb-4">
                <div class="card-header bg-white p-3">
                    <h5 class="fw-bold mb-0 fs-6 text-dark">
                        <i class="fa-solid fa-bolt text-success me-2"></i> Quick Actions
                    </h5>
                </div>
                <div class="card-body p-3">
                    <div class="d-grid gap-2">
                        <a asp-controller="Report" asp-action="Create" class="btn btn-primary text-start py-2.5 px-3 d-flex align-items-center justify-content-between">
                            <div>
                                <i class="fa-solid fa-bullhorn me-2"></i>
                                <span>Report an Issue</span>
                            </div>
                            <i class="fa-solid fa-chevron-right fa-sm"></i>
                        </a>

                        <a asp-controller="Report" asp-action="Track" class="btn btn-secondary text-start py-2.5 px-3 d-flex align-items-center justify-content-between">
                            <div>
                                <i class="fa-solid fa-magnifying-glass me-2 text-success"></i>
                                <span class="text-dark">Track Report Status</span>
                            </div>
                            <i class="fa-solid fa-chevron-right fa-sm text-muted"></i>
                        </a>

                        <a asp-controller="Notification" asp-action="Index" class="btn btn-secondary text-start py-2.5 px-3 d-flex align-items-center justify-content-between">
                            <div>
                                <i class="fa-solid fa-bell me-2 text-success"></i>
                                <span class="text-dark">Notifications</span>
                            </div>
                            <i class="fa-solid fa-chevron-right fa-sm text-muted"></i>
                        </a>

                        <a asp-controller="Account" asp-action="Profile" class="btn btn-secondary text-start py-2.5 px-3 d-flex align-items-center justify-content-between">
                            <div>
                                <i class="fa-solid fa-user-gear me-2 text-success"></i>
                                <span class="text-dark">My User Profile</span>
                            </div>
                            <i class="fa-solid fa-chevron-right fa-sm text-muted"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Category Distribution Widget Card -->
            <div class="card">
                <div class="card-header bg-white p-3">
                    <h5 class="fw-bold mb-0 fs-6 text-dark">
                        <i class="fa-solid fa-chart-pie text-success me-2"></i> Reports by Category
                    </h5>
                </div>
                <div class="card-body p-3">
                    @if (!Model.CategoryCounts.Any())
                    {
                        <p class="text-muted small mb-0 text-center py-3">No category data available yet.</p>
                    }
                    else
                    {
                        foreach (var cat in Model.CategoryCounts)
                        {
                            double pct = Model.TotalReports > 0 ? (double)cat.Value / Model.TotalReports * 100 : 0;
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="small fw-semibold text-dark">@cat.Key</span>
                                    <span class="small text-muted fw-bold">@cat.Value (@pct.ToString("0.#")%)</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-success" role="progressbar" style="width: @pct%" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

        </div>

    </div>

</div>
