@model GreenCityReporter.ViewModels.CitizenDashboardViewModel

@{
    ViewData["Title"] = "Citizen Dashboard";
}

<div class="container py-4">

    <!-- WELCOME / HERO SECTION -->
    <div class="card gcr-hero-card mb-4 shadow-sm">
        <div class="card-body p-4 p-md-5">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <span class="badge bg-white text-success px-3 py-2 rounded-pill mb-3 fw-bold shadow-sm d-inline-flex align-items-center">
                        <i class="fa-solid fa-leaf me-1 text-success"></i> Citizen Service Portal
                    </span>
                    <h1 class="fw-bold mb-2 text-white">Welcome Back to Your Dashboard</h1>
                    <p class="lead mb-0 text-white-50 fs-6">
                        Monitor your civic submissions, track municipal resolution progress, and stay updated on local environmental reports.
                    </p>
                </div>
                <div class="col-md-4 text-center text-md-end mt-4 mt-md-0">
                    <div class="d-flex flex-column flex-sm-row justify-content-md-end gap-2">
                        <a asp-controller="Report" asp-action="Create" class="btn btn-light text-success fw-bold rounded-2 px-4 py-2.5 shadow-sm">
                            <i class="fa-solid fa-circle-plus me-2"></i> Report an Issue
                        </a>
                        <a asp-controller="Report" asp-action="MyReports" class="btn btn-outline-light fw-bold rounded-2 px-3 py-2.5">
                            <i class="fa-solid fa-folder-open me-2"></i> View My Reports
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- QUICK ACTIONS & CATEGORY DISTRIBUTION (BROUGHT TOGETHER) -->
    <div class="row g-4 mb-4">
        <!-- Quick Actions Card -->
        <div class="col-lg-7">
            <div class="card h-100 border shadow-sm">
                <div class="card-header bg-white p-3">
                    <h5 class="fw-bold mb-0 fs-6 text-dark d-flex align-items-center">
                        <i class="fa-solid fa-bolt text-success me-2"></i> Quick Actions
                    </h5>
                </div>
                <div class="card-body p-3">
                    <div class="row g-2">
                        <div class="col-6">
                            <a asp-controller="Report" asp-action="Create" class="btn btn-outline-success w-100 py-3 d-flex flex-column align-items-center justify-content-center gap-2">
                                <i class="fa-solid fa-bullhorn fa-lg"></i>
                                <span class="small fw-bold">Report Issue</span>
                            </a>
                        </div>
                        <div class="col-6">
                            <a asp-controller="Report" asp-action="MyReports" class="btn btn-outline-secondary w-100 py-3 d-flex flex-column align-items-center justify-content-center gap-2">
                                <i class="fa-solid fa-folder-open fa-lg text-success"></i>
                                <span class="small fw-bold text-dark">My Submissions</span>
                            </a>
                        </div>
                        <div class="col-6">
                            <a asp-controller="Report" asp-action="Track" class="btn btn-outline-secondary w-100 py-3 d-flex flex-column align-items-center justify-content-center gap-2">
                                <i class="fa-solid fa-magnifying-glass fa-lg text-success"></i>
                                <span class="small fw-bold text-dark">Track Report</span>
                            </a>
                        </div>
                        <div class="col-6">
                            <a asp-controller="Notification" asp-action="Index" class="btn btn-outline-secondary w-100 py-3 d-flex flex-column align-items-center justify-content-center gap-2 position-relative">
                                <i class="fa-solid fa-bell fa-lg text-warning"></i>
                                <span class="small fw-bold text-dark">Notifications</span>
                                @if (Model.UnreadNotificationCount > 0)
                                {
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-light" style="font-size: 0.65rem;">
                                        @Model.UnreadNotificationCount
                                    </span>
                                }
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Reports by Category Card -->
        <div class="col-lg-5">
            <div class="card h-100 border shadow-sm">
                <div class="card-header bg-white p-3">
                    <h5 class="fw-bold mb-0 fs-6 text-dark d-flex align-items-center">
                        <i class="fa-solid fa-chart-pie text-success me-2"></i> Reports by Category
                    </h5>
                </div>
                <div class="card-body p-3">
                    @if (!Model.CategoryCounts.Any())
                    {
                        <p class="text-muted small mb-0 text-center py-3">No category data available yet.</p>
                    }
                    else
                    {
                        foreach (var cat in Model.CategoryCounts)
                        {
                            double pct = Model.TotalReports > 0 ? (double)cat.Value / Model.TotalReports * 100 : 0;
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="small fw-semibold text-dark">@cat.Key</span>
                                    <span class="small text-muted fw-bold">@cat.Value (@pct.ToString("0.#")%)</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-success" role="progressbar" style="width: @pct%" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- STATISTICS CARDS -->
    <div class="row g-3 mb-4">
        <!-- Card 1: Total Reports -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card h-100 p-3 border">
                <div class="d-flex align-items-center">
                    <div class="rounded-3 p-3 me-3 text-success flex-shrink-0" style="background-color: var(--primary-light);">
                        <i class="fa-solid fa-folder-open fa-2x"></i>
                    </div>
                    <div>
                        <small class="text-muted fw-bold text-uppercase d-block" style="font-size: 0.75rem; letter-spacing: 0.5px;">Total Reports</small>
                        <h2 class="fw-bold mb-0 text-dark">@Model.TotalReports</h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Pending -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card h-100 p-3 border">
                <div class="d-flex align-items-center">
                    <div class="rounded-3 p-3 me-3 flex-shrink-0" style="background-color: var(--pending-bg); color: var(--pending-text);">
                        <i class="fa-regular fa-clock fa-2x"></i>
                    </div>
                    <div>
                        <small class="text-muted fw-bold text-uppercase d-block" style="font-size: 0.75rem; letter-spacing: 0.5px;">Pending Review</small>
                        <h2 class="fw-bold mb-0 text-dark">@Model.PendingCount</h2>
                    </div>
                </div>
            </div>
        </div>

                        <!-- Card 3: Assigned -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card h-100 p-3 border">
                <div class="d-flex align-items-center">
                    <div class="rounded-3 p-3 me-3 flex-shrink-0" style="background-color: var(--progress-bg); color: var(--progress-text);">
                        <i class="fa-solid fa-spinner fa-2x"></i>
                    </div>
                    <div>
                        <small class="text-muted fw-bold text-uppercase d-block" style="font-size: 0.75rem; letter-spacing: 0.5px;">Assigned</small>
                        <h2 class="fw-bold mb-0 text-dark">@Model.AssignedCount</h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 4: Resolved -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card h-100 p-3 border">
                <div class="d-flex align-items-center">
                    <div class="rounded-3 p-3 me-3 flex-shrink-0" style="background-color: var(--resolved-bg); color: var(--resolved-text);">
                        <i class="fa-solid fa-circle-check fa-2x"></i>
                    </div>
                    <div>
                        <small class="text-muted fw-bold text-uppercase d-block" style="font-size: 0.75rem; letter-spacing: 0.5px;">Resolved</small>
                        <h2 class="fw-bold mb-0 text-dark">@Model.ResolvedCount</h2>
                    </div>
                </div>
                <div class="progress mt-3" style="height: 6px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: @Model.ResolutionRate%" aria-valuenow="@Model.ResolutionRate" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <small class="text-muted text-end d-block mt-1" style="font-size: 0.7rem;">@Model.ResolutionRate.ToString("0.#")% Resolution Rate</small>
            </div>
        </div>
    </div>

    <!-- RECENT REPORTS & EMERGENCY HELPLINE -->
    <div class="row g-4">
        
        <!-- Left Column: Recent Submissions -->
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header bg-white p-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 fs-6 text-dark d-flex align-items-center">
                        <i class="fa-solid fa-clock-rotate-left text-success me-2"></i> Recent Submissions
                    </h5>
                    <a asp-controller="Report" asp-action="MyReports" class="btn btn-sm btn-outline-success">
                        View All Reports
                    </a>
                </div>
                <div class="card-body p-0">
                    @if (!Model.RecentReports.Any())
                    {
                        <div class="text-center py-5 px-3">
                            <i class="fa-regular fa-folder-open fa-3x text-muted mb-3 opacity-50"></i>
                            <h5 class="fw-semibold text-dark mb-1">No Reports Submitted Yet</h5>
                            <p class="text-muted small mb-3">Report environmental &amp; civic issues in your neighborhood to initiate action.</p>
                            <a asp-controller="Report" asp-action="Create" class="btn btn-success">
                                <i class="fa-solid fa-plus me-1"></i> Submit Report
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Tracking #</th>
                                        <th>Title</th>
                                        <th>Category</th>
                                        <th>Status</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var report in Model.RecentReports)
                                    {
                                        var reportUrl = Url.Action("Details", "Report", new { id = report.Id });
                                        string statusStr = report.CurrentStatus.ToString();
                                        string badgeClass = report.CurrentStatus.ToString() switch
                                        {
                                            "Pending" => "badge-pending",
                                            "Assigned" => "badge-in-progress",
                                            "Resolved" => "badge-resolved",
                                            "Rejected" => "badge-rejected",
                                            _ => "badge bg-secondary"
                                        };

                                        <tr data-row-href="@reportUrl"
                                            tabindex="0"
                                            aria-label="View report @report.TrackingNumber">
                                            <td>
                                                <span class="tracking-copy-group">
                                                    <span class="tracking-chip">@report.TrackingNumber</span>
                                                    <button type="button"
                                                            class="gcr-copy-tracking"
                                                            data-copy-tracking="@report.TrackingNumber"
                                                            title="Copy tracking number"
                                                            aria-label="Copy tracking number @report.TrackingNumber">
                                                        <i class="fa-regular fa-copy" aria-hidden="true"></i>
                                                        <span class="gcr-copy-label visually-hidden" aria-live="polite">Copy tracking number</span>
                                                    </button>
                                                </span>
                                            </td>
                                            <td class="fw-semibold text-dark">@report.Title</td>
                                            <td><span class="badge bg-light text-dark border">@(report.Category?.Name ?? "General")</span></td>
                                            <td><span class="@badgeClass">@statusStr</span></td>
                                            <td class="text-end">
                                                <a asp-controller="Report" asp-action="Details" asp-route-id="@report.Id" class="btn btn-sm btn-outline-success">
                                                    Details
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Column: Recent Alerts & Emergency Helpline -->
        <div class="col-lg-4">
            
            <!-- Notifications Feed Card -->
            <div class="card mb-4">
                <div class="card-header bg-white p-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 fs-6 text-dark d-flex align-items-center">
                        <i class="fa-solid fa-bell text-success me-2"></i> Recent Alerts
                        @if (Model.UnreadNotificationCount > 0)
                        {
                            <span class="badge bg-danger ms-2" style="font-size: 0.7rem;">@Model.UnreadNotificationCount NEW</span>
                        }
                    </h5>
                    <a asp-controller="Notification" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        View All
                    </a>
                </div>
                <div class="card-body p-3">
                    @if (!Model.RecentNotifications.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="fa-regular fa-bell fa-2x mb-2 text-muted opacity-50"></i>
                            <p class="mb-0 small">No notifications yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var notif in Model.RecentNotifications.Take(3))
                            {
                                string msg = notif.Message;
                                string iconClass = "fa-bell text-primary";
                                string bgBadge = "bg-light";

                                if (msg.Contains("Resolved", StringComparison.OrdinalIgnoreCase))
                                {
                                    iconClass = "fa-circle-check text-success";
                                    bgBadge = "bg-success bg-opacity-10";
                                }
                                else if (msg.Contains("Assigned", StringComparison.OrdinalIgnoreCase))
                                {
                                    iconClass = "fa-bars-progress text-primary";
                                    bgBadge = "bg-primary bg-opacity-10";
                                }
                                else if (msg.Contains("comment", StringComparison.OrdinalIgnoreCase))
                                {
                                    iconClass = "fa-comments text-warning";
                                    bgBadge = "bg-warning bg-opacity-10";
                                }

                                <div class="list-group-item px-0 py-2 d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center me-2">
                                        <div class="rounded-circle p-1.5 me-2 d-flex align-items-center justify-content-center @bgBadge flex-shrink-0" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                            <i class="fa-solid @iconClass"></i>
                                        </div>
                                        <div>
                                            <p class="mb-0 text-dark small text-truncate" style="max-width: 180px;">
                                                @notif.Message
                                            </p>
                                        </div>
                                    </div>
                                    @if (notif.ReportId > 0)
                                    {
                                        <a asp-controller="Report" asp-action="Details" asp-route-id="@notif.ReportId" class="btn btn-sm btn-outline-secondary p-1 px-2" style="font-size: 0.75rem;">
                                            View
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Emergency Helpline Info Card -->
            <div class="card border border-success border-opacity-25 bg-success bg-opacity-10">
                <div class="card-body p-3.5">
                    <div class="d-flex align-items-center mb-2">
                        <i class="fa-solid fa-headset me-3 text-success fs-2"></i>
                        <div>
                            <h6 class="fw-bold text-dark mb-0">Emergency Helpline</h6>
                            <strong class="text-success fs-5">Dial 311</strong>
                        </div>
                    </div>
                    <p class="text-muted small mb-0">
                        For immediate hazards like fallen high-voltage lines or major water main bursts.
                    </p>
                </div>
            </div>

        </div>

    </div>

</div>
