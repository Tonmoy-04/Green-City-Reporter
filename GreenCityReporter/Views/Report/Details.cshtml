@model GreenCityReporter.Models.Report

@{
    ViewData["Title"] = "Report Details";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Report Details</h1>
            <p class="text-muted mb-0">
                View the complete information about your report.
            </p>
        </div>

        <a asp-controller="Report"
           asp-action="MyReports"
           class="btn btn-outline-secondary rounded-pill px-4">
            <i class="fa-solid fa-arrow-left me-2"></i>
            My Reports
        </a>
    </div>

    <div class="row g-4">

        <!-- Main Report Information -->
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start mb-4">

                        <div>
                            <span class="text-muted small">
                                Tracking Number
                            </span>

                            <h5 class="fw-bold text-success mb-0">
                                @Model.TrackingNumber
                            </h5>
                        </div>

                        <div>
                            @switch (Model.CurrentStatus.ToString())
                            {
                                case "Pending":
                                    <span class="badge bg-warning text-dark px-3 py-2">
                                        <i class="fa-regular fa-clock me-1"></i> Pending
                                    </span>
                                    break;

                                case "InProgress":
                                    <span class="badge bg-primary px-3 py-2">
                                        <i class="fa-solid fa-spinner me-1"></i> In Progress
                                    </span>
                                    break;

                                case "Resolved":
                                    <span class="badge bg-success px-3 py-2">
                                        <i class="fa-solid fa-check-circle me-1"></i> Resolved
                                    </span>
                                    break;

                                case "Rejected":
                                    <span class="badge bg-danger px-3 py-2">
                                        <i class="fa-solid fa-xmark-circle me-1"></i> Rejected
                                    </span>
                                    break;

                                default:
                                    <span class="badge bg-secondary px-3 py-2">
                                        @Model.CurrentStatus
                                    </span>
                                    break;
                            }
                        </div>

                    </div>

                    <h2 class="fw-bold mb-3">
                        @Model.Title
                    </h2>
                    
                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <div class="mb-4">
                            <img src="@Model.ImagePath"
                                 alt="Report image"
                                 class="img-fluid rounded-4 shadow-sm"
                                 style="max-height: 450px; width: 100%; object-fit: cover;" />
                        </div>
                    }
                   


                    <!-- Description -->
                    <div class="mb-4">
                        <h6 class="fw-bold">
                            <i class="fa-solid fa-align-left me-2 text-success"></i>
                            Description
                        </h6>

                        <p class="text-muted mb-0">
                            @Model.Description
                        </p>
                    </div>

                    <!-- Address -->
                    <div class="mb-4">
                        <h6 class="fw-bold">
                            <i class="fa-solid fa-location-dot me-2 text-danger"></i>
                            Address
                        </h6>

                        <p class="text-muted mb-0">
                            @Model.Address
                        </p>
                    </div>

                    <!-- Coordinates -->
                    @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                    {
                        <div class="mb-4">

                            <h6 class="fw-bold">
                                <i class="fa-solid fa-map-location-dot me-2 text-primary"></i>
                                Coordinates
                            </h6>

                            <p class="text-muted mb-0">
                                Latitude: @Model.Latitude.Value
                                <br />
                                Longitude: @Model.Longitude.Value
                            </p>

                        </div>
                    }

                    <hr />

                    <!-- Report Metadata -->
                    <div class="row mt-3">

                        <div class="col-md-3 mb-3">

                            <small class="text-muted d-block">
                                Category
                            </small>

                            <span class="fw-medium">
                                @Model.Category?.Name
                            </span>

                        </div>

                        <div class="col-md-3 mb-3">

                            <small class="text-muted d-block">
                                Priority
                            </small>

                            @switch (Model.Priority.ToString())
                            {
                                case "High":
                                    <span class="text-danger fw-medium">
                                        <i class="fa-solid fa-arrow-up me-1"></i> High
                                    </span>
                                    break;

                                case "Medium":
                                    <span class="text-warning fw-medium">
                                        <i class="fa-solid fa-minus me-1"></i> Medium
                                    </span>
                                    break;

                                default:
                                    <span class="text-success fw-medium">
                                        <i class="fa-solid fa-arrow-down me-1"></i> Low
                                    </span>
                                    break;
                            }

                        </div>

                        <div class="col-md-3 mb-3">

                            <small class="text-muted d-block">
                                Submitted
                            </small>

                            <span class="fw-medium">
                                @Model.CreatedAt
                                .ToLocalTime()
                                .ToString("dd MMM yyyy, hh:mm tt")
                            </span>

                        </div>

                        <div class="col-md-3 mb-3">

                            <small class="text-muted d-block">
                                Updated
                            </small>

                            <span class="fw-medium">
                                @Model.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                            </span>

                        </div>

                    </div>

                </div>
            </div>


            <!-- Comments -->
            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header bg-white border-0 p-4">

                    <h5 class="fw-bold mb-0">
                        <i class="fa-solid fa-comments me-2 text-success"></i>
                        Comments
                    </h5>

                </div>

                <div class="card-body p-4">

                    @if (TempData["CommentSuccess"] != null)
                    {
                        <div class="alert alert-success rounded-3">
                            <i class="fa-solid fa-check-circle me-2"></i>
                            @TempData["CommentSuccess"]
                        </div>
                    }

                    @if (TempData["CommentError"] != null)
                    {
                        <div class="alert alert-danger rounded-3">
                            <i class="fa-solid fa-circle-exclamation me-2"></i>
                            @TempData["CommentError"]
                        </div>
                    }


                    <!-- Existing Comments -->
                    @if (Model.Comments != null && Model.Comments.Any())
                    {
                        <div class="comments-list">
                            @foreach (var comment in Model.Comments.OrderByDescending(c => c.CreatedAt))
                            {
                                bool isOwner = comment.UserId == Model.UserId;
                                <div class="card border-0 bg-light rounded-3 mb-3 p-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-secondary bg-opacity-25 text-secondary rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px;">
                                                <i class="fa-solid fa-user fa-sm"></i>
                                            </div>
                                            <strong>@(comment.User?.FullName ?? "Anonymous")</strong>
                                            @if (isOwner)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success ms-2">Author</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary bg-opacity-10 text-primary ms-2">Official</span>
                                            }
                                        </div>
                                        <small class="text-muted">
                                            <i class="fa-regular fa-clock me-1"></i>
                                            @comment.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                        </small>
                                    </div>
                                    <p class="text-dark mb-0 ms-4 ps-2">
                                        @comment.Message
                                    </p>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fa-regular fa-comment-dots fa-2x text-muted mb-3"></i>
                            <p class="text-muted mb-0">
                                No comments on this report yet.
                            </p>
                        </div>
                    }


                    <!-- Add Comment Form -->
                    <div class="border-top pt-4 mt-4">

                        <h6 class="fw-bold mb-3">
                            Add a Comment
                        </h6>

                        <form asp-controller="Report"
                              asp-action="AddComment"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="reportId"
                                   value="@Model.Id" />

                            <div class="mb-3">

                                <textarea name="message"
                                          class="form-control"
                                          rows="4"
                                          maxlength="1000"
                                          placeholder="Write your comment..."
                                          required></textarea>

                                <div class="form-text">
                                    Maximum 1000 characters.
                                </div>

                            </div>

                            <button type="submit"
                                    class="btn btn-success rounded-pill px-4">

                                <i class="fa-solid fa-paper-plane me-2"></i>
                                Add Comment

                            </button>

                        </form>

                    </div>

                </div>

            </div>


        <!-- Status History -->
        <div class="col-lg-4">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header bg-white border-0 p-4">

                    <h5 class="fw-bold mb-0">
                        <i class="fa-solid fa-clock-rotate-left me-2 text-success"></i>
                        Status History
                    </h5>

                </div>

                <div class="card-body p-4">

                    @if (Model.StatusHistories != null && Model.StatusHistories.Any())
                    {
                        <div class="timeline">
                            @foreach (var history in Model.StatusHistories.OrderByDescending(h => h.UpdatedAt))
                            {
                                string newStatusStr = history.NewStatus.ToString() == "InProgress" ? "In Progress" : history.NewStatus.ToString();
                                string badgeClass = history.NewStatus.ToString() switch
                                {
                                    "Pending" => "bg-warning text-dark",
                                    "InProgress" => "bg-primary text-white",
                                    "Resolved" => "bg-success text-white",
                                    "Rejected" => "bg-danger text-white",
                                    _ => "bg-secondary text-white"
                                };

                                <div class="mb-4 pb-2 border-bottom border-light">

                                    <div class="d-flex align-items-start">

                                        <div class="me-3">
                                            <span class="badge @badgeClass p-2 rounded-circle">
                                                <i class="fa-solid fa-rotate"></i>
                                            </span>
                                        </div>

                                        <div class="flex-grow-1">

                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="badge @badgeClass px-2 py-1">
                                                    @newStatusStr
                                                </span>
                                            </div>

                                            <small class="text-muted d-block mt-1">
                                                <i class="fa-regular fa-calendar me-1"></i>
                                                @history.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                            </small>

                                            @if (history.Updater != null)
                                            {
                                                <small class="text-muted d-block">
                                                    <i class="fa-regular fa-user me-1"></i> By: @history.Updater.FullName
                                                </small>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(history.Remarks))
                                            {
                                                <div class="bg-light rounded p-2 mt-2">
                                                    <p class="text-secondary small mb-0">
                                                        <i class="fa-solid fa-comment-dots me-1 text-muted"></i>
                                                        @history.Remarks
                                                    </p>
                                                </div>
                                            }

                                        </div>

                                    </div>

                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">

                            <i class="fa-regular fa-clock fa-2x text-muted mb-3"></i>

                            <p class="text-muted mb-0">
                                No status history available yet.
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>
