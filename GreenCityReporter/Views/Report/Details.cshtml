@model GreenCityReporter.Models.Report

@{
    ViewData["Title"] = "Report Details";
}

<div class="container py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <span class="tracking-chip me-2" style="font-size: 0.95rem;">
                <i class="fa-solid fa-hashtag me-1"></i> @Model.TrackingNumber
            </span>
            <h2 class="fw-bold text-dark mb-0 mt-1">@Model.Title</h2>
        </div>

        <a asp-controller="Report"
           asp-action="MyReports"
           class="btn btn-outline-secondary px-4 mt-3 mt-md-0">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to My Reports
        </a>
    </div>

    <partial name="_ReportSupportCount" model="@((int?)ViewData["SupportCount"] ?? 0)" />

    <!-- 2-Column Desktop Layout (Switches to 1-Column on Mobile) -->
    <div class="row g-4">

        <!-- LEFT COLUMN (8 Cols): Information, Photo, AI Summary, Comments -->
        <div class="col-lg-8">

            <div class="card mb-4">
                <div class="card-body p-4">

                    <!-- Category & Status Bar -->
                    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                        <div>
                            <span class="text-muted small d-block mb-1">Issue Category</span>
                            <span class="badge bg-light text-dark border fs-6 px-3 py-1">
                                <i class="fa-solid fa-tag me-1 text-success"></i> @(Model.Category?.Name ?? "General")
                            </span>
                        </div>

                        <div>
                            @switch (Model.CurrentStatus.ToString())
                            {
                                case "Pending":
                                    <span class="badge-pending">
                                        <i class="fa-regular fa-clock me-1"></i> Pending Review
                                    </span>
                                    break;

                                case "Assigned":
                                    <span class="badge-in-progress">
                                        <i class="fa-solid fa-user-check me-1"></i> Assigned
                                    </span>
                                    break;

                                case "Resolved":
                                    <span class="badge-resolved">
                                        <i class="fa-solid fa-circle-check me-1"></i> Resolved
                                    </span>
                                    break;

                                case "Rejected":
                                    <span class="badge-rejected">
                                        <i class="fa-solid fa-circle-xmark me-1"></i> Rejected
                                    </span>
                                    break;

                                default:
                                    <span class="badge bg-secondary">
                                        @Model.CurrentStatus
                                    </span>
                                    break;
                            }
                        </div>
                    </div>

                    <!-- Report Evidence Image -->
                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <div class="mb-4 text-center bg-light p-2 rounded-3 border">
                            <img src="@Model.ImagePath"
                                 alt="Report evidence photo"
                                 class="img-fluid rounded-2"
                                 style="max-height: 420px; width: 100%; object-fit: cover;" />
                        </div>
                    }

                    <!-- Description -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-dark">
                            <i class="fa-solid fa-align-left me-2 text-success"></i> Issue Description
                        </h6>
                        <p class="text-dark mb-0 bg-light p-3 rounded-3 border">
                            @Model.Description
                        </p>
                    </div>

                    <!-- AI Analysis Summary -->
                    @if (!string.IsNullOrWhiteSpace(Model.AISummary))
                    {
                        <div class="mb-4">
                            <h6 class="fw-bold text-dark">
                                <i class="fa-solid fa-robot me-2 text-primary"></i> AI Analysis Summary
                            </h6>
                            <div class="p-3 bg-primary bg-opacity-10 border border-primary border-opacity-25 rounded-3">
                                <p class="text-dark small mb-0">@Model.AISummary</p>
                            </div>
                        </div>
                    }

                    <!-- Metadata Footer -->
                    <div class="row pt-3 border-top g-3">
                        <div class="col-6 col-md-4">
                            <small class="text-muted d-block">Reported On</small>
                            <span class="fw-semibold text-dark small">@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span>
                        </div>
                        <div class="col-6 col-md-4">
                            <small class="text-muted d-block">Last Updated</small>
                            <span class="fw-semibold text-dark small">@Model.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Discussion & Official Comments Card -->
            <div class="card mb-4">
                <div class="card-header bg-white p-3">
                    <h5 class="fw-bold mb-0 fs-6 text-dark">
                        <i class="fa-solid fa-comments me-2 text-success"></i> Discussion &amp; Official Updates
                    </h5>
                </div>

                <div class="card-body p-4">
                    @if (TempData["CommentSuccess"] != null)
                    {
                        <div class="alert alert-success py-2 px-3 mb-3 small">
                            <i class="fa-solid fa-circle-check me-2"></i> @TempData["CommentSuccess"]
                        </div>
                    }

                    @if (TempData["CommentError"] != null)
                    {
                        <div class="alert alert-danger py-2 px-3 mb-3 small">
                            <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["CommentError"]
                        </div>
                    }

                    <!-- Existing Comments -->
                    @if (Model.Comments != null && Model.Comments.Any())
                    {
                        <div class="comments-list mb-4">
                            @foreach (var comment in Model.Comments.OrderByDescending(c => c.CreatedAt))
                            {
                                bool isOwner = comment.UserId == Model.UserId;
                                <div class="border rounded-3 p-3 mb-3 bg-light">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="d-flex align-items-center">
                                            <span class="rounded-circle bg-secondary text-white me-2 d-inline-flex align-items-center justify-content-center fw-bold" style="width: 28px; height: 28px; font-size: 0.75rem;">
                                                @((comment.User?.FullName ?? "U").Substring(0, 1).ToUpper())
                                            </span>
                                            <strong class="text-dark small me-2">@(comment.User?.FullName ?? "User")</strong>
                                            @if (isOwner)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle">Citizen</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle">Official</span>
                                            }
                                        </div>
                                        <small class="text-muted" style="font-size: 0.75rem;">
                                            @comment.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                        </small>
                                    </div>
                                    <p class="text-dark mb-0 small">@comment.Message</p>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted mb-3">
                            <i class="fa-regular fa-comment-dots fa-2x mb-2 text-muted opacity-50"></i>
                            <p class="mb-0 small">No comments posted yet.</p>
                        </div>
                    }

                    <!-- Add Comment Form -->
                    <div class="border-top pt-3">
                        <h6 class="fw-bold mb-2 text-dark fs-6">Add a Comment</h6>
                        <form asp-controller="Report" asp-action="AddComment" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="reportId" value="@Model.Id" />
                            <div class="mb-3">
                                <textarea name="message" class="form-control" rows="3" maxlength="1000" placeholder="Type your comment or update here..." required></textarea>
                                <div class="form-text">Maximum 1000 characters.</div>
                            </div>
                            <button type="submit" class="btn btn-success px-4 fw-bold">
                                <i class="fa-solid fa-paper-plane me-1"></i> Post Comment
                            </button>
                        </form>
                    </div>
                </div>
            </div>

        </div>

        <!-- RIGHT COLUMN (4 Cols): Status, Priority, Location & Timeline -->
        <div class="col-lg-4">
            
            <!-- Quick Summary Card -->
            <div class="card mb-4">
                <div class="card-header bg-white p-3">
                    <h5 class="fw-bold mb-0 fs-6 text-dark">
                        <i class="fa-solid fa-circle-info text-success me-2"></i> Report Overview
                    </h5>
                </div>
                <div class="card-body p-3">
                    <div class="mb-3 pb-3 border-bottom">
                        <small class="text-muted d-block mb-1">Tracking Number</small>
                        <span class="tracking-chip">@Model.TrackingNumber</span>
                    </div>

                    <div class="mb-3 pb-3 border-bottom">
                        <small class="text-muted d-block mb-1">Priority Level</small>
                        @switch (Model.Priority.ToString())
                        {
                            case "High":
                                <span class="badge-priority-high"><i class="fa-solid fa-arrow-up me-1"></i> High</span>
                                break;
                            case "Medium":
                                <span class="badge-priority-medium"><i class="fa-solid fa-minus me-1"></i> Medium</span>
                                break;
                            case "Critical":
                                <span class="badge-priority-urgent"><i class="fa-solid fa-triangle-exclamation me-1"></i> Critical</span>
                                break;
                            default:
                                <span class="badge-priority-low"><i class="fa-solid fa-arrow-down me-1"></i> Low</span>
                                break;
                        }
                    </div>

                    <div class="mb-0">
                        <small class="text-muted d-block mb-1">Location Address</small>
                        <p class="text-dark small mb-1 fw-medium">@Model.Address</p>
                        @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                        {
                            <span class="badge bg-light text-muted border font-monospace small">
                                <i class="fa-solid fa-location-dot text-danger me-1"></i> @Model.Latitude.Value.ToString("F6"), @Model.Longitude.Value.ToString("F6")
                            </span>
                        }
                    </div>
                </div>
            </div>

            <!-- Status History Timeline Card -->
            <div class="card mb-4">
                <div class="card-header bg-white p-3">
                    <h5 class="fw-bold mb-0 fs-6 text-dark">
                        <i class="fa-solid fa-clock-rotate-left me-2 text-success"></i> Status History
                    </h5>
                </div>

                <div class="card-body p-3">
                    @if (Model.StatusHistories != null && Model.StatusHistories.Any())
                    {
                        <div class="timeline">
                            @foreach (var history in Model.StatusHistories.OrderByDescending(h => h.UpdatedAt))
                            {
                                string newStatusStr = history.NewStatus.ToString();
                                string badgeClass = history.NewStatus.ToString() switch
                                {
                                    "Pending" => "badge-pending",
                                    "Assigned" => "badge-in-progress",
                                    "Resolved" => "badge-resolved",
                                    "Rejected" => "badge-rejected",
                                    _ => "badge bg-secondary"
                                };

                                <div class="mb-3 pb-3 border-bottom">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="@badgeClass">@newStatusStr</span>
                                    </div>
                                    <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">
                                        <i class="fa-regular fa-calendar me-1"></i> @history.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                    </small>
                                    @if (history.Updater != null)
                                    {
                                        <small class="text-muted d-block" style="font-size: 0.75rem;">
                                            <i class="fa-regular fa-user me-1"></i> Updated by: @history.Updater.FullName
                                        </small>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(history.Remarks))
                                    {
                                        <div class="bg-light rounded p-2 mt-2 border">
                                            <p class="text-dark small mb-0">
                                                <i class="fa-solid fa-comment-dots me-1 text-muted"></i> @history.Remarks
                                            </p>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="fa-regular fa-clock fa-2x mb-2 text-muted opacity-50"></i>
                            <p class="mb-0 small">No status history updates recorded yet.</p>
                        </div>
                    }
                </div>
            </div>

        </div>

    </div>

</div>
