@model GreenCityReporter.ViewModels.ReportSubmissionViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "Submit an Environmental Report";
    string googleMapsApiKey = Configuration["GoogleMaps:ApiKey"] 
                              ?? Environment.GetEnvironmentVariable("GoogleMapsApiKey") 
                              ?? Environment.GetEnvironmentVariable("GoogleMaps__ApiKey") 
                              ?? "";
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <style>
        .location-card-header {
            background-color: var(--primary-light);
        }
        .search-suggestion-item:hover {
            background-color: var(--primary-light);
            cursor: pointer;
        }
    </style>
}

<div class="container py-4">
    
    <!-- PAGE HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-3 py-1 mb-1 fw-semibold">
                <i class="fa-solid fa-leaf me-1 text-warning"></i> Civic Reporting Tool
            </span>
            <h2 class="fw-bold text-dark mb-0">Submit an Environmental Report</h2>
            <p class="text-muted small mb-0">Help keep Dhaka clean &amp; safe by logging municipal infrastructure hazards.</p>
        </div>
        <a asp-controller="Report" asp-action="Dashboard" class="btn btn-outline-secondary px-4 mt-3 mt-md-0">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>

    <!-- PROGRESS / INFORMATION AREA -->
    <div class="alert alert-success border-success border-opacity-25 bg-success bg-opacity-10 mb-4 py-3 px-4 rounded-3 d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center">
            <div class="rounded-circle bg-success text-white p-2.5 me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                <i class="fa-solid fa-wand-magic-sparkles fs-5"></i>
            </div>
            <div>
                <strong class="text-dark small d-block">AI-Assisted Issue Processing</strong>
                <span class="text-muted small">Our AI engine will analyze your title and description to auto-detect urgency, category, and summary on the review step.</span>
            </div>
        </div>
        <span class="badge bg-success d-none d-md-inline-block">Step 1 of 2</span>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-9 col-xl-8">
            <div class="alert alert-warning small py-2 px-3">For immediate emergencies, contact the appropriate emergency service directly. Green City Reporter submissions do not replace emergency services.</div>
            
            <form asp-action="Review" method="post" enctype="multipart/form-data" id="report-submission-form">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <!-- Hidden fields to store selected coordinates -->
                <input type="hidden" asp-for="Latitude" id="Latitude" />
                <input type="hidden" asp-for="Longitude" id="Longitude" />

                <!-- CARD 1: REPORT DETAILS -->
                <div class="card mb-4">
                    <div class="card-header bg-white p-3">
                        <h5 class="fw-bold mb-0 fs-6 text-dark d-flex align-items-center">
                            <i class="fa-solid fa-pen-to-square text-success me-2"></i> 1. Report Details
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold">
                                Report Title <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Title"
                                   class="form-control"
                                   placeholder="e.g. Overflowing waste bin near Gulshan 2 circle" required />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-0">
                            <label asp-for="Description" class="form-label fw-bold">
                                Issue Description <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Provide detailed context about the issue, landmark context, and hazard severity..." required></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- CARD 2: LOCATION CARD & INTERACTIVE MAP -->
                <div class="card mb-4" id="map-section">
                    <div class="card-header location-card-header p-3 d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0 fs-6 text-dark d-flex align-items-center">
                            <i class="fa-solid fa-map-location-dot text-success me-2"></i> 2. Pin Location on Dhaka Map
                        </h5>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1">
                            <i class="fa-solid fa-shield-halved me-1"></i>Dhaka Boundary Protected
                        </span>
                    </div>

                    <div class="card-body p-4">
                        <!-- Address Text Input -->
                        <div class="mb-3">
                            <label asp-for="Address" class="form-label fw-bold">
                                Selected Address / Area <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Address"
                                      id="Address"
                                      class="form-control"
                                      rows="2"
                                      placeholder="Search address below, click on map, or type street name..." required></textarea>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <!-- Search & Current Location Controls -->
                        <div class="row g-2 mb-3">
                            <div class="col-md-7 position-relative">
                                <div class="input-group">
                                    <span class="input-group-text bg-white text-success border-end-0">
                                        <i class="fa-solid fa-magnifying-glass"></i>
                                    </span>
                                    <input type="text"
                                           id="address-search-input"
                                           class="form-control border-start-0"
                                           placeholder="Search address or landmark in Dhaka..."
                                           autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="search-results-dropdown" aria-describedby="location-search-help" />
                                </div>
                                <div id="location-search-help" class="form-text">Type at least 3 characters, then choose a place to pin it on the map.</div>
                                <!-- Suggestion Dropdown -->
                                <div id="search-results-dropdown" role="listbox" aria-label="Location suggestions" class="dropdown-menu w-100 border p-1 shadow mt-1 d-none position-absolute" style="z-index: 1050; max-height: 240px; overflow-y: auto;"></div>
                            </div>
                            <div class="col-md-5">
                                <button type="button" id="use-current-location-btn" class="btn btn-outline-success w-100 fw-semibold">
                                    <i class="fa-solid fa-location-crosshairs me-1"></i> Use My Current Location
                                </button>
                            </div>
                        </div>

                        <!-- Map Canvas Container -->
                        <div id="location-picker-map" class="shadow-sm"></div>

                        <!-- Validation / Boundary Error Alert -->
                        <div id="map-error-alert" class="alert alert-danger d-none mt-3 py-2 px-3 small align-items-center">
                            <i class="fa-solid fa-triangle-exclamation me-2 fs-5"></i>
                            <span id="map-error-text">Please select a valid location inside Dhaka city bounds.</span>
                        </div>

                        <!-- Selected Location Banner -->
                        <div id="location-info-selected" class="alert alert-success d-none mt-3 mb-0 py-2.5 px-3 d-flex align-items-center justify-content-between rounded-3">
                            <div class="d-flex align-items-center">
                                <i class="fa-solid fa-location-dot text-danger fs-4 me-3"></i>
                                <div>
                                    <div class="fw-bold text-dark small" id="banner-address-display">Selected Location</div>
                                    <small class="text-muted font-monospace" id="banner-coords-display"></small>
                                    <span class="badge bg-success ms-2">Dhaka City, Bangladesh</span>
                                </div>
                            </div>
                            <button type="button" id="clear-location-btn" class="btn btn-sm btn-outline-danger">
                                <i class="fa-solid fa-xmark me-1"></i>Clear
                            </button>
                        </div>

                        <div id="location-info-empty" class="alert alert-light border mt-3 mb-0 py-2 px-3 d-flex align-items-center text-muted rounded-3 small">
                            <i class="fa-solid fa-circle-info text-primary me-2"></i>
                            <span>No location pinned yet. Search an address, click on map, or tap "Use My Current Location".</span>
                        </div>

                        <span asp-validation-for="Latitude" class="text-danger small d-block mt-2"></span>
                        <span asp-validation-for="Longitude" class="text-danger small d-block mt-1"></span>
                    </div>
                </div>

                <!-- CARD 3: PHOTO EVIDENCE UPLOAD -->
                <div class="card mb-4">
                    <div class="card-header bg-white p-3">
                        <h5 class="fw-bold mb-0 fs-6 text-dark d-flex align-items-center">
                            <i class="fa-solid fa-camera text-success me-2"></i> 3. Upload Photo Evidence
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-0">
                            <label class="form-label fw-bold">Attach Image</label>
                            <input type="file"
                                   name="image"
                                   class="form-control"
                                   accept="image/*" />
                            <div class="form-text">
                                Upload a photo showing the issue clear view (Optional, JPG/PNG max 5MB).
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ACTION BUTTONS -->
                <div class="d-flex justify-content-between pt-2">
                    <a asp-controller="Report" asp-action="Dashboard" class="btn btn-outline-secondary px-4">
                        Cancel
                    </a>

                    <button type="submit" class="btn btn-success px-5 py-2.5 fw-bold shadow-sm">
                        <i class="fa-solid fa-arrow-right me-1"></i> Proceed to Review Report
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    
    @if (!string.IsNullOrWhiteSpace(googleMapsApiKey))
    {
        <script src="https://maps.googleapis.com/maps/api/js?key=@googleMapsApiKey&libraries=places"></script>
    }

    <script src="~/js/location-search.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            const GOOGLE_MAPS_KEY = "@googleMapsApiKey";
            const DHAKA_LAT_MIN = 23.60;
            const DHAKA_LAT_MAX = 23.95;
            const DHAKA_LNG_MIN = 90.25;
            const DHAKA_LNG_MAX = 90.55;

            const DEFAULT_LAT = 23.8103;
            const DEFAULT_LNG = 90.4125;
            const DEFAULT_ZOOM = 13;

            let isGoogleMapsActive = false;
            let googleMap = null;
            let googleMarker = null;
            let googleGeocoder = null;

            let leafletMap = null;
            let leafletMarker = null;

            function isInsideDhaka(lat, lng) {
                return lat >= DHAKA_LAT_MIN && lat <= DHAKA_LAT_MAX &&
                       lng >= DHAKA_LNG_MIN && lng <= DHAKA_LNG_MAX;
            }

            function showMapError(msg) {
                $('#map-error-text').text(msg);
                $('#map-error-alert').removeClass('d-none').addClass('d-flex');
            }

            function hideMapError() {
                $('#map-error-alert').addClass('d-none').removeClass('d-flex');
                $('#map-error-text').text('');
            }

            function updateUI(lat, lng, addressText) {
                const formattedLat = parseFloat(lat).toFixed(6);
                const formattedLng = parseFloat(lng).toFixed(6);

                $('#Latitude').val(formattedLat);
                $('#Longitude').val(formattedLng);

                if (addressText && addressText.trim() !== '') {
                    $('#Address').val(addressText);
                    $('#banner-address-display').text(addressText);
                } else if ($('#Address').val()) {
                    $('#banner-address-display').text($('#Address').val());
                } else {
                    $('#banner-address-display').text("Pinned Location (" + formattedLat + ", " + formattedLng + ")");
                }

                $('#banner-coords-display').text(formattedLat + ', ' + formattedLng);
                $('#location-info-empty').addClass('d-none');
                $('#location-info-selected').removeClass('d-none').addClass('d-flex');
                hideMapError();
            }

            function clearLocationUI() {
                $('#Latitude').val('');
                $('#Longitude').val('');
                $('#location-info-selected').addClass('d-none').removeClass('d-flex');
                $('#location-info-empty').removeClass('d-none');
                hideMapError();
            }

            function reverseGeocodeNominatim(lat, lng) {
                const url = `https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}`;
                $.getJSON(url, function (data) {
                    if (data && data.display_name) {
                        updateUI(lat, lng, data.display_name);
                    } else {
                        updateUI(lat, lng, null);
                    }
                }).fail(function () {
                    updateUI(lat, lng, null);
                });
            }

            function reverseGeocodeGoogle(lat, lng) {
                if (!googleGeocoder) return;
                const latlng = { lat: parseFloat(lat), lng: parseFloat(lng) };
                googleGeocoder.geocode({ location: latlng }, function (results, status) {
                    if (status === 'OK' && results[0]) {
                        updateUI(lat, lng, results[0].formatted_address);
                    } else {
                        updateUI(lat, lng, null);
                    }
                });
            }

            function processLocationSelection(lat, lng, addressText = null) {
                if (!isInsideDhaka(lat, lng)) {
                    showMapError("Selected location is outside Dhaka City bounds. Please pick a spot inside Dhaka.");
                    return false;
                }

                if (isGoogleMapsActive && googleMap && googleMarker) {
                    const pos = new google.maps.LatLng(lat, lng);
                    googleMarker.setPosition(pos);
                    googleMarker.setVisible(true);
                    googleMap.panTo(pos);

                    if (addressText) {
                        updateUI(lat, lng, addressText);
                    } else {
                        reverseGeocodeGoogle(lat, lng);
                    }
                } else if (leafletMap) {
                    if (!leafletMarker) {
                        leafletMarker = L.marker([lat, lng], { draggable: true }).addTo(leafletMap);
                        leafletMarker.on('dragend', function (e) {
                            const newPos = e.target.getLatLng();
                            processLocationSelection(newPos.lat, newPos.lng);
                        });
                    } else {
                        leafletMarker.setLatLng([lat, lng]);
                    }
                    leafletMap.panTo([lat, lng]);

                    if (addressText) {
                        updateUI(lat, lng, addressText);
                    } else {
                        reverseGeocodeNominatim(lat, lng);
                    }
                }

                return true;
            }

            function initGoogleMapsEngine() {
                try {
                    const mapElement = document.getElementById('location-picker-map');
                    const dhakaCenter = { lat: DEFAULT_LAT, lng: DEFAULT_LNG };

                    googleMap = new google.maps.Map(mapElement, {
                        center: dhakaCenter,
                        zoom: DEFAULT_ZOOM,
                        mapTypeControl: true,
                        streetViewControl: false,
                        fullscreenControl: true
                    });

                    googleMarker = new google.maps.Marker({
                        position: dhakaCenter,
                        map: googleMap,
                        draggable: true,
                        visible: false,
                        title: "Drag to refine report location"
                    });

                    googleGeocoder = new google.maps.Geocoder();
                    isGoogleMapsActive = true;

                    const searchInput = document.getElementById('address-search-input');
                    const autocomplete = new google.maps.places.Autocomplete(searchInput, {
                        componentRestrictions: { country: 'bd' },
                        bounds: { south: DHAKA_LAT_MIN, north: DHAKA_LAT_MAX, west: DHAKA_LNG_MIN, east: DHAKA_LNG_MAX },
                        strictBounds: true,
                        fields: ['geometry', 'formatted_address', 'name']
                    });

                    autocomplete.addListener('place_changed', function () {
                        const place = autocomplete.getPlace();
                        if (place.geometry && place.geometry.location) {
                            const lat = place.geometry.location.lat();
                            const lng = place.geometry.location.lng();
                            processLocationSelection(lat, lng, place.formatted_address || place.name);
                        }
                    });

                    googleMap.addListener('click', function (e) {
                        processLocationSelection(e.latLng.lat(), e.latLng.lng());
                    });

                    googleMarker.addListener('dragend', function (e) {
                        processLocationSelection(e.latLng.lat(), e.latLng.lng());
                    });

                } catch (err) {
                    console.warn("Google Maps failed to initialize, falling back to Leaflet:", err);
                    initLeafletEngine();
                }
            }

            function initLeafletEngine() {
                isGoogleMapsActive = false;
                const DHAKA_SW = L.latLng(DHAKA_LAT_MIN, DHAKA_LNG_MIN);
                const DHAKA_NE = L.latLng(DHAKA_LAT_MAX, DHAKA_LNG_MAX);
                const dhakaBounds = L.latLngBounds(DHAKA_SW, DHAKA_NE);

                leafletMap = L.map('location-picker-map', {
                    center: [DEFAULT_LAT, DEFAULT_LNG],
                    zoom: DEFAULT_ZOOM,
                    minZoom: 11,
                    maxZoom: 18,
                    maxBounds: dhakaBounds,
                    maxBoundsViscosity: 1.0
                });

                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '&copy; OpenStreetMap contributors'
                }).addTo(leafletMap);

                leafletMap.on('click', function (e) {
                    processLocationSelection(e.latlng.lat, e.latlng.lng);
                });

                initLocationSearch({
                    input: document.getElementById('address-search-input'),
                    dropdown: document.getElementById('search-results-dropdown'),
                    selectLocation: function (lat, lng, address) {
                        if (processLocationSelection(lat, lng, address)) {
                            leafletMap.setView([lat, lng], 16);
                            return true;
                        }
                        return false;
                    },
                    isInsideBounds: isInsideDhaka
                });
            }
            if (GOOGLE_MAPS_KEY && typeof google !== 'undefined' && typeof google.maps !== 'undefined') {
                initGoogleMapsEngine();
            } else {
                initLeafletEngine();
            }

            $('#use-current-location-btn').on('click', function () {
                const btn = $(this);
                const originalHtml = btn.html();
                btn.html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Locating...').prop('disabled', true);

                if (!navigator.geolocation) {
                    showMapError("Geolocation is not supported by your browser. Please search or click on map.");
                    btn.html(originalHtml).prop('disabled', false);
                    return;
                }

                navigator.geolocation.getCurrentPosition(
                    function (position) {
                        btn.html(originalHtml).prop('disabled', false);
                        const lat = position.coords.latitude;
                        const lng = position.coords.longitude;
                        if (!processLocationSelection(lat, lng)) {
                            showMapError("Your current location is outside Dhaka City reporting bounds.");
                        }
                    },
                    function (error) {
                        btn.html(originalHtml).prop('disabled', false);
                        showMapError("Unable to access your current location. Please search for an address or select a location on the map.");
                    },
                    { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
                );
            });

            $('#clear-location-btn').on('click', function () {
                clearLocationUI();
                if (googleMarker) googleMarker.setVisible(false);
                if (leafletMarker && leafletMap) {
                    leafletMap.removeLayer(leafletMarker);
                    leafletMarker = null;
                }
            });

            const existingLat = parseFloat($('#Latitude').val());
            const existingLng = parseFloat($('#Longitude').val());
            if (!isNaN(existingLat) && !isNaN(existingLng)) {
                processLocationSelection(existingLat, existingLng, $('#Address').val());
            }

            $('#report-submission-form').on('submit', function (e) {
                const lat = $('#Latitude').val();
                const lng = $('#Longitude').val();
                const addr = $('#Address').val();

                if (!lat || !lng || !addr || addr.trim() === '') {
                    showMapError("Please select a valid issue location on the map before submitting.");
                    $('html, body').animate({
                        scrollTop: $("#map-section").offset().top - 80
                    }, 400);
                    return false;
                }
            });
        });
    </script>
}
