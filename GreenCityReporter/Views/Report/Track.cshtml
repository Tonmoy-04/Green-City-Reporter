@model string

@{
    ViewData["Title"] = "Track Report";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card mb-4">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center p-3 mb-3 text-success" style="width: 64px; height: 64px; background-color: var(--gcr-secondary-light);">
                            <i class="fa-solid fa-magnifying-glass-location fa-2x"></i>
                        </div>
                        <h3 class="fw-bold text-dark mb-1">Track Your Report</h3>
                        <p class="text-muted small mb-0">
                            Enter your report tracking number to view real-time resolution status.
                        </p>
                    </div>

                    @if (TempData["TrackError"] != null)
                    {
                        <div class="alert alert-danger py-2 px-3 mb-4 small d-flex align-items-center">
                            <i class="fa-solid fa-circle-exclamation me-2"></i>
                            <div>@TempData["TrackError"]</div>
                        </div>
                    }

                    <form asp-controller="Report" asp-action="Track" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label for="trackingNumber" class="form-label text-dark">
                                Tracking Number
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <i class="fa-solid fa-hashtag"></i>
                                </span>
                                <input type="text"
                                       id="trackingNumber"
                                       name="trackingNumber"
                                       class="form-control border-start-0 font-monospace fw-bold"
                                       placeholder="e.g. GCR-20260914-1234"
                                       value="@Model"
                                       required />
                            </div>
                            <div class="form-text mt-2 text-muted small">
                                <i class="fa-solid fa-shield-halved me-1 text-success"></i>
                                Logged-in citizens can track issues associated with their registered account.
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-success fw-bold py-2.5">
                                <i class="fa-solid fa-magnifying-glass me-2"></i> Search Tracking System
                            </button>
                        </div>
                    </form>

                </div>
            </div>

            <div class="card bg-light border">
                <div class="card-body p-4 text-center">
                    <h6 class="fw-bold text-dark mb-1">
                        <i class="fa-solid fa-folder-open me-2 text-success"></i>Want to review all your submissions?
                    </h6>
                    <p class="text-muted small mb-3">
                        View your full history of reported issues in your citizen dashboard.
                    </p>
                    <a asp-controller="Report" asp-action="MyReports" class="btn btn-sm btn-outline-success">
                        Go to My Reports
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>
