@model string

@{
    ViewData["Title"] = "Track Report";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex align-items-center justify-content-center p-3 mb-3" style="width: 70px; height: 70px;">
                            <i class="fa-solid fa-magnifying-glass-location fa-2x"></i>
                        </div>
                        <h2 class="fw-bold mb-2">Track Your Report</h2>
                        <p class="text-muted">
                            Enter your unique report tracking number to view real-time updates and progress.
                        </p>
                    </div>

                    @if (TempData["TrackError"] != null)
                    {
                        <div class="alert alert-danger rounded-3 mb-4 d-flex align-items-center">
                            <i class="fa-solid fa-circle-exclamation me-2 fa-lg"></i>
                            <div>@TempData["TrackError"]</div>
                        </div>
                    }

                    <form asp-controller="Report" asp-action="Track" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label for="trackingNumber" class="form-label fw-medium text-dark">
                                Tracking Number
                            </label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <i class="fa-solid fa-hashtag"></i>
                                </span>
                                <input type="text"
                                       id="trackingNumber"
                                       name="trackingNumber"
                                       class="form-control bg-light border-start-0"
                                       placeholder="e.g. GCR-20260827012345-1234"
                                       value="@Model"
                                       required />
                            </div>
                            <div class="form-text mt-2 text-muted">
                                <i class="fa-solid fa-shield-halved me-1 text-success"></i>
                                For privacy and security, citizens can track reports submitted from their account.
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-success btn-lg rounded-pill fw-medium shadow-sm py-3">
                                <i class="fa-solid fa-magnifying-glass me-2"></i> Find Report
                            </button>
                        </div>
                    </form>

                </div>
            </div>

            <div class="card border-0 bg-light rounded-4 mt-4">
                <div class="card-body p-4 text-center">
                    <h6 class="fw-bold text-dark mb-2">
                        <i class="fa-solid fa-circle-info me-2 text-success"></i>Need to check your submitted issues?
                    </h6>
                    <p class="text-muted small mb-3">
                        You can view all your submitted reports and track their status in one place.
                    </p>
                    <a asp-controller="Report" asp-action="MyReports" class="btn btn-sm btn-outline-success rounded-pill px-4">
                        Go to My Reports
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>

