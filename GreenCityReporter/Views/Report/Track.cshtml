@model string

@{
    ViewData["Title"] = "Track Report";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 p-4 pb-0">
                    <h3 class="fw-bold mb-1 text-center">Track Your Report</h3>
                    <p class="text-muted text-center mb-0">
                        Enter your tracking number below to view the current status and details of your report.
                    </p>
                </div>
                <div class="card-body p-4">
                    @if (TempData["TrackError"] != null)
                    {
                        <div class="alert alert-danger rounded-3 mb-4">
                            <i class="fa-solid fa-circle-exclamation me-2"></i>
                            @TempData["TrackError"]
                        </div>
                    }

                    <form asp-controller="Report" asp-action="Track" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-4">
                            <label for="trackingNumber" class="form-label fw-medium">Tracking Number</label>
                            <input type="text" id="trackingNumber" name="trackingNumber" class="form-control form-control-lg" placeholder="e.g. GCR-20260827012345-1234" value="@Model" required />
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-success btn-lg rounded-pill">
                                <i class="fa-solid fa-magnifying-glass me-2"></i> Track Report
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
