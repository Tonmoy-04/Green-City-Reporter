@model IEnumerable<GreenCityReporter.Models.Report>

@{
    ViewData["Title"] = "My Reports";
}

<div class="container py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-folder-open text-success me-2"></i>My Reports
            </h2>
            <p class="text-muted small mb-0">
                Track status and progress of all civic issues you have reported.
            </p>
        </div>

        <a asp-controller="Report"
           asp-action="Create"
           class="btn btn-success px-4 mt-3 mt-md-0">
            <i class="fa-solid fa-plus me-1"></i>
            Submit New Report
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card mb-4">
            <div class="card-body text-center py-5">
                <div class="mb-3">
                    <i class="fa-solid fa-file-circle-xmark fa-3x text-muted opacity-50"></i>
                </div>
                <h4 class="fw-bold text-dark">No Reports Found</h4>
                <p class="text-muted mb-4 small">
                    You haven't submitted any environmental or infrastructure reports yet.
                </p>
                <a asp-controller="Report"
                   asp-action="Create"
                   class="btn btn-success px-4">
                    <i class="fa-solid fa-bullhorn me-1"></i>
                    Report an Issue
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="px-4">Tracking Number</th>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Submitted Date</th>
                            <th class="text-end px-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in Model)
                        {
                            <tr>
                                <td class="px-4">
                                    <span class="fw-bold font-monospace text-success small">
                                        @report.TrackingNumber
                                    </span>
                                </td>

                                <td class="fw-semibold text-dark">
                                    @report.Title
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(report.Category?.Name ?? "Uncategorized")
                                    </span>
                                </td>

                                <td>
                                    @switch (report.CurrentStatus.ToString())
                                    {
                                        case "Pending":
                                            <span class="badge-pending">
                                                <i class="fa-regular fa-clock me-1"></i> Pending
                                            </span>
                                            break;

                                        case "InProgress":
                                            <span class="badge-in-progress">
                                                <i class="fa-solid fa-spinner me-1"></i> In Progress
                                            </span>
                                            break;

                                        case "Resolved":
                                            <span class="badge-resolved">
                                                <i class="fa-solid fa-circle-check me-1"></i> Resolved
                                            </span>
                                            break;

                                        case "Rejected":
                                            <span class="badge-rejected">
                                                <i class="fa-solid fa-circle-xmark me-1"></i> Rejected
                                            </span>
                                            break;

                                        default:
                                            <span class="badge bg-secondary">
                                                @report.CurrentStatus
                                            </span>
                                            break;
                                    }
                                </td>

                                <td>
                                    @switch (report.Priority.ToString())
                                    {
                                        case "High":
                                            <span class="badge-priority-high">
                                                <i class="fa-solid fa-arrow-up me-1"></i> High
                                            </span>
                                            break;

                                        case "Medium":
                                            <span class="badge-priority-medium">
                                                <i class="fa-solid fa-minus me-1"></i> Medium
                                            </span>
                                            break;

                                        case "Critical":
                                            <span class="badge-priority-urgent">
                                                <i class="fa-solid fa-triangle-exclamation me-1"></i> Critical
                                            </span>
                                            break;

                                        default:
                                            <span class="badge-priority-low">
                                                <i class="fa-solid fa-arrow-down me-1"></i> Low
                                            </span>
                                            break;
                                    }
                                </td>

                                <td>
                                    <span class="text-muted small">
                                        @report.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                    </span>
                                </td>

                                <td class="text-end px-4">
                                    <a asp-controller="Report"
                                       asp-action="Details"
                                       asp-route-id="@report.Id"
                                       class="btn btn-sm btn-outline-success">
                                        View Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>
