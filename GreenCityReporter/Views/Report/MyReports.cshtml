
@model IEnumerable<GreenCityReporter.Models.Report>

@{
    ViewData["Title"] = "My Reports";
}

<div class="container py-5">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">My Reports</h1>
            <p class="text-muted mb-0">
                View and track the environmental issues you have reported.
            </p>
        </div>

        <a asp-controller="Report"
           asp-action="Create"
           class="btn btn-success rounded-pill px-4 mt-3 mt-md-0">
            <i class="fa-solid fa-plus me-2"></i>
            Submit New Report
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center py-5">

                <div class="mb-3">
                    <i class="fa-solid fa-file-circle-xmark fa-3x text-muted"></i>
                </div>

                <h4 class="fw-bold">No Reports Yet</h4>

                <p class="text-muted mb-4">
                    You haven't submitted any environmental reports yet.
                </p>

                <a asp-controller="Report"
                   asp-action="Create"
                   class="btn btn-success rounded-pill px-4">
                    <i class="fa-solid fa-bullhorn me-2"></i>
                    Report an Issue
                </a>

            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="px-4">Tracking Number</th>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Date</th>
                            <th class="text-end px-4">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var report in Model)
                        {
                            <tr>

                                <td class="px-4">
                                    <span class="fw-medium text-success">
                                        @report.TrackingNumber
                                    </span>
                                </td>

                                <td>
                                    <span class="fw-medium">
                                        @report.Title
                                    </span>
                                </td>

                                <td>
                                    @report.Category?.Name
                                </td>

                                <td>
                                    @switch (report.CurrentStatus.ToString())
                                    {
                                        case "Pending":
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                            break;

                                        case "InProgress":
                                            <span class="badge bg-primary">
                                                In Progress
                                            </span>
                                            break;

                                        case "Resolved":
                                            <span class="badge bg-success">
                                                Resolved
                                            </span>
                                            break;

                                        case "Rejected":
                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>
                                            break;

                                        default:
                                            <span class="badge bg-secondary">
                                                @report.CurrentStatus
                                            </span>
                                            break;
                                    }
                                </td>

                                <td>
                                    @switch (report.Priority.ToString())
                                    {
                                        case "High":
                                            <span class="text-danger fw-medium">
                                                <i class="fa-solid fa-arrow-up me-1"></i>
                                                High
                                            </span>
                                            break;

                                        case "Medium":
                                            <span class="text-warning fw-medium">
                                                <i class="fa-solid fa-minus me-1"></i>
                                                Medium
                                            </span>
                                            break;

                                        default:
                                            <span class="text-success fw-medium">
                                                <i class="fa-solid fa-arrow-down me-1"></i>
                                                Low
                                            </span>
                                            break;
                                    }
                                </td>

                                <td>
                                    <span class="text-muted">
                                        @report.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                    </span>
                                </td>

                                <td class="text-end px-4">
                                    <a asp-controller="Report"
                                       asp-action="Details"
                                       asp-route-id="@report.Id"
                                       class="btn btn-sm btn-outline-success rounded-pill px-3">
                                        View
                                    </a>
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    }

</div>

