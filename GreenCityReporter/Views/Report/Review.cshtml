@model GreenCityReporter.ViewModels.ReportReviewViewModel

@{
    ViewData["Title"] = "Review Report";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 p-4">
                    <h2 class="fw-bold mb-1">Review Your Report</h2>
                    <p class="text-muted mb-0">Check the details and confirm submission.</p>
                </div>

                <div class="card-body p-4">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
                    {
                        <img src="@Model.ImagePath" alt="Report image" class="img-fluid rounded-3 mb-4" style="max-height: 360px; width: 100%; object-fit: cover;" />
                    }

                    <dl class="row">
                        <dt class="col-sm-3">Title</dt>
                        <dd class="col-sm-9">@Model.Title</dd>

                        <dt class="col-sm-3">Description</dt>
                        <dd class="col-sm-9">@Model.Description</dd>

                        <dt class="col-sm-3">Address</dt>
                        <dd class="col-sm-9">@Model.Address</dd>

                        @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                        {
                            <dt class="col-sm-3">Coordinates</dt>
                            <dd class="col-sm-9">@Model.Latitude, @Model.Longitude</dd>
                        }

                        <dt class="col-sm-3">AI Summary</dt>
                        <dd class="col-sm-9">@(Model.AISummary ?? "AI summary unavailable.")</dd>

                        <dt class="col-sm-3">Priority</dt>
                        <dd class="col-sm-9"><span class="badge bg-secondary">@Model.Priority</span></dd>
                    </dl>

                    <form asp-action="Confirm" method="post">
                        @Html.AntiForgeryToken()
                        <input asp-for="Title" type="hidden" />
                        <input asp-for="Description" type="hidden" />
                        <input asp-for="Address" type="hidden" />
                        <input asp-for="Latitude" type="hidden" />
                        <input asp-for="Longitude" type="hidden" />
                        <input asp-for="ImagePath" type="hidden" />

                        @if (Model.RequiresManualCategory)
                        {
                            <div class="mb-4">
                                <label asp-for="SelectedCategoryId" class="form-label">Category</label>
                                <p class="text-muted small">Category could not be determined automatically. Please select a category.</p>
                                <select asp-for="SelectedCategoryId" asp-items="Model.Categories" class="form-select">
                                    <option value="">-- Select Category --</option>
                                </select>
                                <span asp-validation-for="SelectedCategoryId" class="text-danger"></span>
                            </div>
                        }
                        else
                        {
                            <div class="mb-4">
                                <span class="form-label d-block">Detected Category</span>
                                <strong>@Model.AICategoryName</strong>
                                <span class="badge bg-success ms-2">AI Categorized</span>
                            </div>
                        }

                        <div class="d-flex justify-content-between">
                            <a asp-action="Create" class="btn btn-outline-secondary">Back / Edit Report</a>
                            <button type="submit" class="btn btn-success">Confirm &amp; Submit</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}