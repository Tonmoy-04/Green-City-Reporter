@model GreenCityReporter.ViewModels.ReportReviewViewModel

@{
    ViewData["Title"] = "Review Report";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9 col-xl-8">
            <div class="card mb-4">
                <div class="card-header bg-white p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="fw-bold mb-1 text-success">
                            <i class="fa-solid fa-clipboard-check me-2"></i>Review Your Report
                        </h3>
                        <p class="text-muted small mb-0">Please verify your submission details before final confirmation.</p>
                    </div>
                    <span class="badge bg-success px-3 py-2">Step 2 of 2</span>
                </div>

                <div class="card-body p-4">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Photo Preview if uploaded -->
                    @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
                    {
                        <div class="mb-4 text-center bg-light p-2 rounded-3 border">
                            <img src="@Model.ImagePath" alt="Report evidence photo" class="img-fluid rounded-2" style="max-height: 320px; width: 100%; object-fit: cover;" />
                        </div>
                    }

                    <!-- User-Provided Information Section -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-dark mb-3">
                            <i class="fa-solid fa-user me-2 text-success"></i> User-Provided Information
                            <span class="badge bg-light text-dark border ms-2">Manual</span>
                        </h6>
                        <div class="p-3 bg-light rounded-3 border">
                            <dl class="row mb-0">
                                <dt class="col-sm-3 text-muted">Title</dt>
                                <dd class="col-sm-9 fw-bold text-dark">@Model.Title</dd>

                                <dt class="col-sm-3 text-muted">Description</dt>
                                <dd class="col-sm-9 text-dark">@Model.Description</dd>

                                <dt class="col-sm-3 text-muted">Address / Area</dt>
                                <dd class="col-sm-9 text-dark">@Model.Address</dd>

                                @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                                {
                                    <dt class="col-sm-3 text-muted">Map Pin</dt>
                                    <dd class="col-sm-9 font-monospace text-dark mb-0">
                                        <i class="fa-solid fa-location-dot text-danger me-1"></i> @Model.Latitude.Value.ToString("F6"), @Model.Longitude.Value.ToString("F6")
                                    </dd>
                                }
                            </dl>
                        </div>
                    </div>

                    <!-- AI-Generated Analysis Section -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-dark mb-3">
                            <i class="fa-solid fa-robot me-2 text-primary"></i> AI Assistant Processing
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-2"><i class="fa-solid fa-sparkles me-1"></i> AI Suggested</span>
                        </h6>

                        <div class="p-3 bg-primary bg-opacity-10 border border-primary border-opacity-25 rounded-3 mb-3">
                            <h6 class="fw-bold text-dark mb-1 fs-6">AI Concise Summary</h6>
                            <p class="text-dark small mb-0">@(Model.AISummary ?? "AI summary generation pending.")</p>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="p-3 bg-light rounded-3 border h-100">
                                    <small class="text-muted d-block mb-1">Estimated Priority</small>
                                    @{
                                        string prioClass = Model.Priority switch {
                                            GreenCityReporter.Models.Enums.Priority.Low => "badge-priority-low",
                                            GreenCityReporter.Models.Enums.Priority.Medium => "badge-priority-medium",
                                            GreenCityReporter.Models.Enums.Priority.High => "badge-priority-high",
                                            GreenCityReporter.Models.Enums.Priority.Critical => "badge-priority-urgent",
                                            _ => "badge bg-secondary"
                                        };
                                    }
                                    <span class="@prioClass me-2">@Model.Priority Priority</span>
                                    <span class="badge bg-light text-muted border">AI Estimated</span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="p-3 bg-light rounded-3 border h-100">
                                    <small class="text-muted d-block mb-1">Detected Category</small>
                                    @if (!Model.RequiresManualCategory)
                                    {
                                        <strong class="text-dark fs-6 me-2">@Model.AICategoryName</strong>
                                        <span class="badge bg-success"><i class="fa-solid fa-robot me-1"></i> Auto-Categorized</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark"><i class="fa-solid fa-triangle-exclamation me-1"></i> Selection Required</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="mt-3 small text-muted">
                            Critical: <strong>@(Model.IsCritical ? "Yes" : "No")</strong>
                            | Confidence: <strong>@(Model.AIConfidence?.ToString("P0") ?? "Unavailable")</strong>
                        </div>
                    </div>

                    <form asp-action="Confirm" method="post">
                        @Html.AntiForgeryToken()
                        <input asp-for="Title" type="hidden" />
                        <input asp-for="Description" type="hidden" />
                        <input asp-for="Address" type="hidden" />
                        <input asp-for="Latitude" type="hidden" />
                        <input asp-for="Longitude" type="hidden" />
                        <input asp-for="ImagePath" type="hidden" />

                        <div class="mb-4 p-3 bg-light border rounded-3">
                            <label asp-for="SelectedCategoryId" class="form-label fw-bold">Final Category <span class="text-danger">*</span></label>
                            <p class="text-muted small mb-2">You may accept the AI suggestion or choose another category.</p>
                            <select asp-for="SelectedCategoryId" asp-items="Model.Categories" class="form-select" required>
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="SelectedCategoryId" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between pt-3 border-top">
                            <a asp-action="Create" class="btn btn-outline-secondary px-4">
                                <i class="fa-solid fa-arrow-left me-1"></i> Back to Edit
                            </a>
                            <button type="submit" class="btn btn-success fw-bold px-5 py-2.5 shadow-sm">
                                <i class="fa-solid fa-paper-plane me-2"></i> Confirm &amp; Submit Report
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}